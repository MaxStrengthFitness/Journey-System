rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // GLOBAL SAFETY NET
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // RBAC & MULTI-TENANCY HELPERS
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Primary lookup: trainer doc by UID (for trainers created via Firebase Auth UID as doc ID)
    function getTrainerByUID() {
      return exists(/databases/$(database)/documents/trainers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/trainers/$(request.auth.uid)).data
        : null;
    }

    // Get trainer data — UID-keyed doc is the primary source
    function getTrainerData() {
      return get(/databases/$(database)/documents/trainers/$(request.auth.uid)).data;
    }

    // Check if a trainer document exists keyed by the Firebase UID
    function trainerDocExistsByUID() {
      return exists(/databases/$(database)/documents/trainers/$(request.auth.uid));
    }

    function getRole() {
      // Check JWT token claim first (fastest, no DB read)
      return request.auth != null && 'role' in request.auth.token && request.auth.token.role != null
        ? request.auth.token.role
        : (trainerDocExistsByUID()
            ? (('role' in getTrainerData() && getTrainerData().role != null)
                ? getTrainerData().role
                : 'LifeTransformer')  // Default: any authenticated trainer can train
            : 'none');
    }

    // Any authenticated user with a trainer profile anywhere in the system
    function hasAnyTrainerProfile() {
      return isAuthenticated() && trainerDocExistsByUID();
    }

    // Cost round (Sep 2026): both go through getRole(), which reads the token's
    // role claim and only falls back to trainers/{uid} when there is none. The
    // old bodies checked the claim, then ALWAYS did an exists()/get() for any
    // non-matching claim -- so a LifeTransformer's every isSuperAdmin() cost a
    // read even with a claim. The Cloud Function syncTrainerClaims keeps the
    // claim equal to the document; the answers here are unchanged either way.
    function isAdmin() {
      return isAuthenticated() && getRole() == 'Admin';
    }

    function isFounder() {
      return isAuthenticated() && (getRole() == 'Founder' || getRole() == 'Overseer');
    }

    // 1. SUPER ADMIN: Absolute master access to everything
    function isSuperAdmin() {
      return isAdmin() || isFounder();
    }

    // 2. FRANCHISE OWNER: no company-wide helper any more. The franchise
    //    partition (Oct 2026; ROADMAP Gate B) made a franchise owner one of
    //    a studio's leaders, at their home and owned studios only
    //    (roleRunsOwnStudios, below), so isFranchiseOwnerOnly() and
    //    isFranchiseOwner() were removed with every branch that called them.

    // 3. A STUDIO'S LEADERS: the studio tier and its franchise owner, strictly bounded by location
    function isStudioOwnerOrHeadTrainerOnly(studioId) {
      return isAuthenticated() && (
        // Demo Mode: everyone leads there. See the demo helpers above.
        hasRunOfDemo(studioId) ||
        // Secure Custom Token Claim check
        ('studioId' in request.auth.token && request.auth.token.studioId != null && request.auth.token.studioId == studioId) ||
        // Database Backed verification fallback
        (
          trainerDocExistsByUID() &&
          // The franchise partition (Oct 2026): a franchise owner leads their
          // home and owned studios as a studio leader does. getRole() once.
          roleRunsOwnStudios(getRole()) &&
          (
            getTrainerData().primaryHomeStudioId == studioId || 
            ('ownedStudioIds' in getTrainerData() && getTrainerData().ownedStudioIds != null && getTrainerData().ownedStudioIds.hasAny([studioId]))
          )
        ) ||
        // THE GRANT (My Studio round, Sep 2026): a trainer this studio's
        // leadership let help run it -- Trainer.managedStudioIds names the
        // studio. Whatever their role. Set only by that studio's leaders and
        // administrators (it is an access field; see writesAccessFields).
        (
          trainerDocExistsByUID() &&
          getTrainerData().get('managedStudioIds', []).hasAny([studioId])
        )
      );
    }

    function isStudioOwnerOrHeadTrainer(studioId) {
      return isStudioOwnerOrHeadTrainerOnly(studioId);
    }

    // 4. TRAINER: Any authenticated trainer at a studio — checks primary home, accessible, and guest studios
    function isTrainerOfStudioOnly(studioId) {
      return isAuthenticated() && trainerDocExistsByUID() && (
        // Demo Mode: everyone works there. See the demo helpers above.
        isDemoStudioId(studioId) ||
        (
          getTrainerData().primaryHomeStudioId == studioId ||
          ('accessibleStudioIds' in getTrainerData() && getTrainerData().accessibleStudioIds != null && getTrainerData().accessibleStudioIds.hasAny([studioId])) ||
          ('activeGuestStudioIds' in getTrainerData() && getTrainerData().activeGuestStudioIds != null && getTrainerData().activeGuestStudioIds.hasAny([studioId]))
        )
      );
    }

    // Extended: LifeTransformer and Trainer roles can train at their studio
    function isTrainerOfStudio(studioId) {
      return isStudioOwnerOrHeadTrainerOnly(studioId) || isTrainerOfStudioOnly(studioId);
    }

    // 5. ANY AUTHENTICATED TRAINER: For session writes, any trainer with a valid profile
    // can write sessions as long as they are authenticated — the hostedAtStudioId is set by the app
    function isAnyAuthenticatedTrainer() {
      return isAuthenticated() && trainerDocExistsByUID();
    }

    // ===============================================================
    // DEMO MODE (Sep 20 2026)
    // ===============================================================
    // Why: docs/ops/RULES-NOTES.md#isdemostudioid

    function isDemoStudioId(studioId) {
      return studioId == 'demo-studio';
    }

    /** Everybody signed in, inside the demo studio. */
    function hasRunOfDemo(studioId) {
      return isDemoStudioId(studioId) && isAnyAuthenticatedTrainer();
    }

    // Why: docs/ops/RULES-NOTES.md#isdemotrainerpayload
    function isDemoTrainerPayload(trainerId, data) {
      return trainerId.matches('demo-trainer-.*') &&
             data.get('isDemo', false) == true &&
             data.get('primaryHomeStudioId', '') == 'demo-studio' &&
             data.get('accessibleStudioIds', []).hasOnly(['demo-studio']) &&
             data.get('managedStudioIds', []).size() == 0 &&
             data.get('ownedStudioIds', []).size() == 0 &&
             (data.get('role', '') == 'StudioLeader' ||
              data.get('role', '') == 'LifeTransformer');
    }

    // 5. HELPER: Resolve studio or homeStudioId field safely from a data map
    function getStudioIdFromData(data) {
      return data.get('homeStudioId', data.get('studioId', null));
    }

    function isTrainerOfClientData(clientId, clientData, trainerPrimary, trainerAccessible, trainerGuest) {
      return (getStudioIdFromData(clientData) != null && isTrainerOfStudio(getStudioIdFromData(clientData))) ||
             (clientData.get('approvedCrossTrainStudioIds', []).hasAny([trainerPrimary])) ||
             (clientData.get('approvedCrossTrainStudioIds', []).hasAny(trainerAccessible)) ||
             (clientData.get('approvedCrossTrainStudioIds', []).hasAny(trainerGuest));
    }

    // Why: docs/ops/RULES-NOTES.md#clientcreatehonest
    function clientCreateHonest(clientId, d) {
      return d.get('approvedCrossTrainStudioIds', []).size() == 0
          && (!isDemoStudioId(getStudioIdFromData(d))
              || !clientId.matches('^[0-9]+(-[0-9]+)?$'));
    }

    function isTrainerOfClient(clientId) {
      return exists(/databases/$(database)/documents/clients/$(clientId)) && 
             isTrainerOfClientData(
               clientId,
               get(/databases/$(database)/documents/clients/$(clientId)).data,
               getTrainerData().primaryHomeStudioId,
               getTrainerData().get('accessibleStudioIds', []),
               getTrainerData().get('activeGuestStudioIds', [])
             );
    }

    // Can this trainer see the session at /sessions/{id}? Used by the logs
    // subcollection, which is addressable without the parent.
    function isTrainerOfSessionId(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId))
        && isTrainerOfSessionData(
             get(/databases/$(database)/documents/sessions/$(sessionId)).data);
    }

    function isTrainerOfSessionData(sessionData) {
      return sessionData.get('trainerId', '') == request.auth.uid
          || isTrainerOfStudio(sessionData.get('hostedAtStudioId', ''))
          || namedClientIsReadable(sessionData.get('clientId', ''));
    }

    // isTrainerOfClient builds /documents/clients/$(id). An empty id makes
    // that path malformed, so the emptiness check has to come first and the
    // short-circuit has to be relied on. Sessions written before
    // `hostedAtStudioId` was enforced also predate a reliable clientId.
    function namedClientIsReadable(clientId) {
      return clientId != null && clientId != '' && isTrainerOfClient(clientId);
    }

    // ===============================================================
    // EXPRESSION-BUDGET HELPERS  (Sep 9 2026)
    // ===============================================================
    // Why: docs/ops/RULES-NOTES.md#roleissuper

    function roleIsSuper(r) {
      return r == 'Admin' || r == 'Founder' || r == 'Overseer';
    }

    function roleIsFranchise(r) {
      return r == 'FranchiseOwner' || r == 'Owner';
    }

    function roleIsStudioLeader(r) {
      return r == 'StudioOwner' || r == 'HeadTrainer' || r == 'StudioLeader';
    }

    /* The roles that run their OWN studios: the studio tier's three, and
       (the franchise partition, Oct 2026; ROADMAP Gate B) the franchise
       owner, who leads their home studio and every studio an administrator
       marked them as owning (trainers/{uid}.ownedStudioIds), exactly as a
       studio leader leads theirs -- and nothing anywhere else. */
    function roleRunsOwnStudios(r) {
      return roleIsStudioLeader(r) || roleIsFranchise(r);
    }

    /** The caller's trainer document, or null. One read, one call site. */
    function callerTrainer() {
      return trainerDocExistsByUID() ? getTrainerData() : null;
    }

    /* THE ROLE ON A TRAINER DOCUMENT, read the way getRole() reads it when
       there is no claim: missing or null is 'LifeTransformer'; no document
       is 'none'. Pure map work. */
    function recordRoleOf(d) {
      return d == null ? 'none'
          : (d.get('role', null) == null ? 'LifeTransformer' : d.get('role', null));
    }

    // Why: docs/ops/RULES-NOTES.md#authorityrole
    function authorityRole(t) {
      return t != null ? recordRoleOf(t) : getRole();
    }

    /** An administrator by their own document (authorityRole), or by the
     *  claim when there is no document. For authority writes only. */
    function superOnRecord() {
      return isAuthenticated() && roleIsSuper(authorityRole(callerTrainer()));
    }

    /** Works here, as a trainer. Pure map lookups against an already-read doc. */
    function trainerWorksAt(t, studioId) {
      return t != null && studioId != null && studioId != '' && (
        isDemoStudioId(studioId) ||
        t.get('primaryHomeStudioId', '') == studioId ||
        t.get('accessibleStudioIds', []).hasAny([studioId]) ||
        t.get('activeGuestStudioIds', []).hasAny([studioId])
      );
    }

    /** Runs this location: a leader role or a franchise owner at the home or an owned studio, the grant, or Demo Mode. Mirrors isStudioOwnerOrHeadTrainerOnly's DB branch. */
    function trainerLeads(r, t, studioId) {
      return studioId != null && studioId != '' && (
        (t != null && isDemoStudioId(studioId)) ||
        // The custom-claim fast path, carried over verbatim from
        // isStudioOwnerOrHeadTrainerOnly. It never fires: the only claim
        // ever set is `role` (syncTrainerClaims, cost round Sep 2026), and
        // `studioId` is deliberately never set -- as written it would grant
        // studio-leader access with no role check at all.
        ('studioId' in request.auth.token &&
          request.auth.token.studioId != null &&
          request.auth.token.studioId == studioId) ||
        (t != null && roleRunsOwnStudios(r) && (
          t.get('primaryHomeStudioId', '') == studioId ||
          t.get('ownedStudioIds', []).hasAny([studioId])
        )) ||
        // The grant (My Studio round, Sep 2026) -- see isStudioOwnerOrHeadTrainerOnly.
        (t != null && t.get('managedStudioIds', []).hasAny([studioId]))
      );
    }

    /* WHAT A CALLER MAY HAND OUT (My Studio round, Sep 2026). AJ, Sep 18:
       a studio's leaders hand out trainer, head trainer and studio leader --
       "never owner and admin". A franchise owner may hand out the owner
       tier too, AT THE STUDIOS THEY RUN (the update and create rules ask
       that first; the franchise partition, Oct 2026). Administrators,
       anything. A null role is "not set yet". */
    function studioTierRole(role) {
      return role == null || role == 'LifeTransformer' || role == 'Trainer'
          || role == 'HeadTrainer' || role == 'StudioLeader';
    }

    function mayHandOut(r, role) {
      return roleIsSuper(r)
          || (roleIsFranchise(r) && !roleIsSuper(role))
          || studioTierRole(role);
    }

    /** homeStudioId, falling back to studioId. Mirrors getStudioIdFromData. */
    function studioIdOf(d) {
      return d.get('homeStudioId', d.get('studioId', ''));
    }

    // Why: docs/ops/RULES-NOTES.md#clientisreadableby
    function clientIsReadableBy(c, r, t) {
      return t != null && (
        c.get('approvedCrossTrainStudioIds', []).hasAny([t.get('primaryHomeStudioId', '')]) ||
        c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('accessibleStudioIds', [])) ||
        c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('activeGuestStudioIds', [])) ||
        trainerWorksAt(t, studioIdOf(c)) ||
        trainerLeads(r, t, studioIdOf(c))
      );
    }

    // Why: docs/ops/RULES-NOTES.md#crosstrainsessiontotals
    function crossTrainSessionTotals(c, t) {
      return t != null
        && (c.get('approvedCrossTrainStudioIds', []).hasAny([t.get('primaryHomeStudioId', '')])
            || c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('accessibleStudioIds', []))
            || c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('activeGuestStudioIds', [])))
        && request.resource.data.diff(c).affectedKeys().hasOnly([
             'completedSessions', 'sessionCount', 'lastSessionDate', 'updatedAt',
             'lifetimeReps', 'lifetimeWeight', 'currentMachineMetrics', 'consultationCompleted',
             'trainerTally', 'trainerTallyUpdatedAt', 'topTrainerId', 'topTrainerName',
             'topTrainerSessions', 'machineStats', 'isRoutineBActive', 'firstSessionDate',
             'subjectiveSnapshot']);
    }

    /*
     * The one document read on this path. Guarded on a non-empty id first:
     * isTrainerOfClient('') builds the malformed path /documents/clients/ and
     * relies on short-circuit to never get there.
     */
    function sessionClientIsReadable(cid, r, t) {
      return cid != null && cid != '' &&
        exists(/databases/$(database)/documents/clients/$(cid)) &&
        clientIsReadableBy(
          get(/databases/$(database)/documents/clients/$(cid)).data, r, t);
    }

    /*
     * SESSIONS ARE SCOPED BY CLIENT, NOT BY STUDIO -- unchanged policy, see the
     * comment above match /sessions. A session is never more visible than the
     * person it is about, and a legacy session with no studio and no client
     * stays readable by its own trainer rather than by nobody. A franchise
     * owner walks the leader's branches (the franchise partition, Oct 2026).
     */
    function sessionIsReadable(s, r, t) {
      return roleIsSuper(r) || (t != null && (
        s.get('trainerId', '') == request.auth.uid ||
        trainerWorksAt(t, s.get('hostedAtStudioId', '')) ||
        trainerLeads(r, t, s.get('hostedAtStudioId', '')) ||
        sessionClientIsReadable(s.get('clientId', ''), r, t)
      ));
    }

    // ===============================================================
    // RENEWALS (Renewals round, Sep 2026)
    // ===============================================================
    // Why: docs/ops/RULES-NOTES.md#renewalsreadable

    function renewalsReadable(studioId, r, t) {
      return roleIsSuper(r) ||
             trainerWorksAt(t, studioId) || trainerLeads(r, t, studioId);
    }

    function renewalsManageable(studioId, r, t) {
      return roleIsSuper(r) || trainerLeads(r, t, studioId);
    }

    // Why: docs/ops/RULES-NOTES.md#wave2leads
    function wave2Leads(studioId) {
      let r = getRole();
      let t = callerTrainer();
      return renewalsManageable(studioId, r, t);
    }

    function wave2WorksHere(studioId) {
      let r = getRole();
      let t = callerTrainer();
      return renewalsReadable(studioId, r, t);
    }

    /* A FRANCHISE OWNER OF THIS STUDIO (the franchise partition, Oct 2026).
       For the rules that only administrators and franchise owners could pass
       (a FORD detail's delete): the franchise owner keeps it, at the studios
       they run, and nobody else gains it. */
    function franchiseRunsStudio(studioId) {
      let r = getRole();
      return roleIsFranchise(r) && trainerLeads(r, callerTrainer(), studioId);
    }

    // Why: docs/ops/RULES-NOTES.md#franchiserunsclient
    function franchiseRunsClient(clientId) {
      let r = getRole();
      return roleIsFranchise(r)
          && clientId is string && clientId != ''
          && exists(/databases/$(database)/documents/clients/$(clientId))
          && trainerLeads(r, callerTrainer(),
               studioIdOf(get(/databases/$(database)/documents/clients/$(clientId)).data));
    }

    /** Absent, or a number inside [lo, hi]. */
    function numberWithin(d, key, lo, hi) {
      return !(key in d) || (d[key] is number && d[key] >= lo && d[key] <= hi);
    }

    /* THE STUDIO SETTINGS (Sep 28 2026, AJ: "let the admins assign the default
       within the app"; features/studio-settings). One `values` map of plain
       numbers (or null for a weekday's "none"), who saved it (the Auth uid)
       and when. Which keys exist and what is usable is the app's registry and
       resolve.ts; the rules hold the shape and who may write. */
    function studioSettingsValid(d) {
      return d.keys().hasOnly(['values', 'updatedAt', 'updatedBy'])
          && d.values is map
          && d.values.size() <= 40
          && d.updatedBy == request.auth.uid;
    }

    // Why: docs/ops/RULES-NOTES.md#startingchoicevalid
    function startingChoiceValid(d) {
      return d.keys().hasAll(['use', 'defaultId', 'updatedAt', 'updatedBy'])
          && d.keys().hasOnly(['use', 'defaultId', 'updatedAt', 'updatedBy'])
          && (d.use == null || (d.use is list && d.use.size() <= 80))
          && (d.defaultId == null || (d.defaultId is string && d.defaultId.size() <= 200))
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
    }

    // Why: docs/ops/RULES-NOTES.md#renewalsettingsvalid
    function renewalSettingsValid(d) {
      return d.keys().hasOnly([
               'conversationAtSessionsLeft', 'chargeWarnDays', 'chargeWarnMinBanked',
               'horizonMonths', 'breakDays', 'lostAfterDays', 'payAsYouGoCountsAs',
               'pauseDuringAwayEvents', 'packagesRenewAutomatically', 'packages',
               'extraSessionNames', 'updatedAt', 'updatedBy'])
          && numberWithin(d, 'conversationAtSessionsLeft', 0, 60)
          && numberWithin(d, 'chargeWarnDays', 0, 180)
          && numberWithin(d, 'chargeWarnMinBanked', 1, 100)
          && numberWithin(d, 'horizonMonths', 1, 12)
          && numberWithin(d, 'breakDays', 7, 90)
          && numberWithin(d, 'lostAfterDays', 0, 365)
          && (!('payAsYouGoCountsAs' in d) || d.payAsYouGoCountsAs in ['retained', 'lost'])
          && (!('pauseDuringAwayEvents' in d) || d.pauseDuringAwayEvents is bool)
          && (!('packagesRenewAutomatically' in d) || d.packagesRenewAutomatically is bool)
          && (!('packages' in d) ||
              (d.packages is list && d.packages.size() >= 1 && d.packages.size() <= 12))
          && (!('extraSessionNames' in d) ||
              (d.extraSessionNames is list && d.extraSessionNames.size() <= 40))
          && d.get('updatedBy', '') == request.auth.uid;
    }

    /** What a trainer's conversation log may write on a renewal cycle. */
    function renewalTrainerKeys() {
      return ['clientId', 'clientName', 'cycleKey', 'packageKey', 'chargeDate',
              'latestLeaning', 'latestConcerns', 'latestInterestedIn',
              'needsLeader', 'lastTouchAt', 'lastTouchBy', 'lastTouchByName',
              'touchCount'];
    }

    /**
     * Leaders may also set the stage, the lead and the outcome. EVERY field
     * the nightly job writes must be listed here too: a leader's write is
     * checked against the whole document, so one unlisted job field would
     * lock leaders out of that cycle for good.
     */
    function renewalCycleKeys() {
      return renewalTrainerKeys().concat([
              'stage', 'leadTrainerId', 'outcome', 'outcomeAt', 'outcomeBy',
              'nextCycleKey', 'nextPackageKey', 'closedOn', 'primaryTrainerId',
              'updatedAt', 'updatedBy', 'plan']);
    }

    /* THE RENEWAL PLAN (the renewals dashboard, Oct 7 2026; AJ: "allow in
       app response", and for studios without auto-renew "mark if a client is
       set to renew or not"). features/renewals/plan.ts is the app's half:
       PLAN_LABELS lists the same choices. Anyone who works at the studio
       sets it, signed and stamped by the server, with one touch of kind
       "plan" in the same batch; it never touches the outcome. */
    function renewalPlanChoices() {
      return ['let-renew', 'pause-billing', 'renew-same', 'upgrade', 'downgrade',
              'pay-as-you-go', 'not-renewing', 'undecided'];
    }

    function renewalPlanValid(p) {
      return p is map
          && p.keys().hasAll(['choice', 'byUid', 'byName', 'at'])
          && p.keys().hasOnly(['choice', 'packageKey', 'note', 'byUid', 'byName', 'at'])
          && p.choice in renewalPlanChoices()
          && p.byUid == request.auth.uid
          && p.byName is string && p.byName.size() >= 1 && p.byName.size() <= 80
          && p.at == request.time
          && (!('packageKey' in p) || p.packageKey == null ||
              (p.packageKey is string && p.packageKey.size() <= 40))
          && (!('note' in p) || (p.note is string && p.note.size() <= 500));
    }

    /** What a plan change may write on a cycle: the plan, its context, the touch count. */
    function renewalPlanKeys() {
      return ['clientId', 'clientName', 'cycleKey', 'packageKey', 'chargeDate',
              'plan', 'touchCount'];
    }

    function renewalPlanWrite() {
      let d = request.resource.data;
      return renewalPlanValid(d.get('plan', null))
          && d.get('touchCount', 0) ==
               (resource == null ? 0 : resource.data.get('touchCount', 0)) + 1
          && (resource == null
                ? d.keys().hasOnly(renewalPlanKeys())
                : d.diff(resource.data).affectedKeys().hasOnly(renewalPlanKeys()));
    }

    function renewalLeanings() {
      return ['renewing', 'leaning-yes', 'unsure', 'leaning-no', 'not-renewing'];
    }

    /**
     * A trainer logging a conversation: only the trainer fields change, and
     * the conversation is signed by the person writing it.
     */
    function renewalTrainerWrite() {
      return request.resource.data.get('lastTouchBy', '') == request.auth.uid
          && request.resource.data.get('latestLeaning', 'unsure') in renewalLeanings()
          // Only as a side effect of logging a conversation, now: stamped by
          // the server, and counted one at a time.
          && request.resource.data.get('lastTouchAt', null) == request.time
          && request.resource.data.get('touchCount', 0) ==
               (resource == null ? 0 : resource.data.get('touchCount', 0)) + 1
          && (resource == null
                ? request.resource.data.keys().hasOnly(renewalTrainerKeys())
                : request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(renewalTrainerKeys()));
    }

    function renewalLeaderWrite() {
      return request.resource.data.keys().hasOnly(renewalCycleKeys())
          && request.resource.data.get('stage', 'not-started') in ['not-started', 'talking', 'decided']
          && (request.resource.data.get('outcome', null) == null ||
              request.resource.data.outcome in
                ['renewed', 'upgraded', 'downgraded', 'pay-as-you-go', 'lost'])
          && (request.resource.data.get('closedOn', null) == null ||
              (request.resource.data.closedOn is string &&
               request.resource.data.closedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          // A leader changing the plan holds it to the same shape.
          && (!request.resource.data.diff(resource == null ? {} : resource.data)
                .affectedKeys().hasAny(['plan'])
              || renewalPlanValid(request.resource.data.plan));
    }

    /** One logged conversation. Signed by its author; never edited. */
    function renewalTouchValid(d) {
      return d.keys().hasOnly(['clientId', 'authorId', 'authorName', 'at', 'leaning',
                               'concerns', 'interestedIn', 'note', 'needsLeader',
                               'kind', 'plan'])
          && d.authorId == request.auth.uid
          && d.at == request.time
          && d.leaning in renewalLeanings()
          && d.concerns is list && d.concerns.size() <= 8
          && d.note is string && d.note.size() <= 500
          && d.needsLeader is bool
          // A plan change's touch (Oct 7 2026): kind "plan" and the plan's choice.
          && (!('kind' in d) || (d.kind == 'plan' && 'plan' in d))
          && (!('plan' in d) ||
              (d.plan is map
               && d.plan.keys().hasAll(['choice'])
               && d.plan.keys().hasOnly(['choice', 'packageKey'])
               && d.plan.choice in renewalPlanChoices()
               && (!('packageKey' in d.plan) || d.plan.packageKey == null ||
                   (d.plan.packageKey is string && d.plan.packageKey.size() <= 40))));
    }

    // ===============================================================
    // INBODY SCANS (Renewals round, Sep 2026)
    // ===============================================================
    // Why: docs/ops/RULES-NOTES.md#inbodynumber

    function inbodyNumber(d, key, lo, hi) {
      return d[key] is number && d[key] >= lo && d[key] <= hi;
    }

    /** Absent, null, or a number inside [lo, hi]. */
    function inbodyOptional(d, key, lo, hi) {
      return !(key in d) || d[key] == null || inbodyNumber(d, key, lo, hi);
    }

    function inbodyScanValid(d) {
      return d.keys().hasOnly(['testedAt', 'device', 'source', 'studioId', 'enteredBy',
                               'enteredByName', 'createdAt', 'updatedBy', 'updatedAt',
                               'weightLb', 'skeletalMuscleMassLb', 'bodyFatMassLb',
                               'percentBodyFat', 'bmi', 'totalBodyWaterLb', 'dryLeanMassLb',
                               'fatFreeMassLb', 'basalMetabolicRateKcal', 'smi', 'phaseAngle',
                               'segmentalLean'])
          && d.testedAt is string && d.testedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.device is string && d.device.size() <= 40
          && inbodyNumber(d, 'weightLb', 20, 800)
          && inbodyNumber(d, 'skeletalMuscleMassLb', 1, 400)
          && inbodyNumber(d, 'bodyFatMassLb', 0, 700)
          && inbodyNumber(d, 'percentBodyFat', 0, 90)
          && d.skeletalMuscleMassLb + d.bodyFatMassLb < d.weightLb
          && inbodyOptional(d, 'bmi', 5, 100)
          && inbodyOptional(d, 'totalBodyWaterLb', 0, 500)
          && inbodyOptional(d, 'dryLeanMassLb', 0, 300)
          && inbodyOptional(d, 'fatFreeMassLb', 0, 800)
          && inbodyOptional(d, 'basalMetabolicRateKcal', 0, 10000)
          && inbodyOptional(d, 'smi', 0, 40)
          && inbodyOptional(d, 'phaseAngle', 0, 30)
          && (!('segmentalLean' in d) || d.segmentalLean == null || d.segmentalLean is map);
    }

    /** The scan's client's studio. One read, cached for the whole request. */
    function inbodyClientStudio(clientId) {
      return studioIdOf(get(/databases/$(database)/documents/clients/$(clientId)).data);
    }

    /** Mirrors match /clients/{clientId}'s update rule.
     *  Takes the pre-computed role string and trainer map so it stays within
     *  the 1000-expression budget. Callers must pass getRole() and callerTrainer().
     */
    function inbodyWritable(clientId, r, t) {
      return t != null
          && exists(/databases/$(database)/documents/clients/$(clientId))
          && (roleIsSuper(r)
              || trainerWorksAt(t, inbodyClientStudio(clientId))
              || trainerLeads(r, t, inbodyClientStudio(clientId)));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // VALIDATORS & PROPERTY MATCHERS
    // ===============================================================

    // Why: docs/ops/RULES-NOTES.md#selfcreatedroleisallowed
    function selfCreatedRoleIsAllowed() {
      return !('role' in request.resource.data)
          || request.resource.data.role == null
          // The owner's own bootstrap, mirroring useAuthInitialization.ts.
          || (request.resource.data.role == 'Admin'
              && request.auth.token.email == 'jurgensaj@gmail.com')
          || (request.resource.data.role != 'Admin'
              && request.resource.data.role != 'Founder'
              && request.resource.data.role != 'Overseer');
    }

    // Why: docs/ops/RULES-NOTES.md#isownerbootstrap
    function isOwnerBootstrap() {
      return request.auth.token.get('email', '') == 'jurgensaj@gmail.com';
    }

    function claimMatchesPlaceholder(p, data) {
      return p.get('pendingClaim', false) == true
          && p.get('supersededByUid', null) == null
          && p.get('email', '') is string
          && p.get('email', '') != ''
          && p.email.lower() == request.auth.token.email.lower()
          && data.get('authUid', request.auth.uid) == request.auth.uid
          && data.diff(p).affectedKeys().hasOnly([
               // claimedProfile(): dropped, then added.
               'pendingClaim', 'supersededByUid', 'id',
               'claimedFromId', 'claimedAt', 'authUid'
             ]);
    }

    function selfCreateIsAClaim(trainerId) {
      let data = request.resource.data;
      let fromId = data.get('claimedFromId', '');
      return fromId is string
          && fromId != ''
          && fromId != trainerId
          && request.auth.token.get('email', '') is string
          && request.auth.token.get('email', '') != ''
          && exists(/databases/$(database)/documents/trainers/$(fromId))
          && claimMatchesPlaceholder(
               get(/databases/$(database)/documents/trainers/$(fromId)).data,
               data);
    }

    // Why: docs/ops/RULES-NOTES.md#approvercreateallowed
    function approverCreateAllowed(trainerId, d) {
      let t = callerTrainer();
      let r = authorityRole(t);
      return roleIsSuper(r)
          || (!isDemoStudioId(d.primaryHomeStudioId)
              && trainerLeads(r, t, d.primaryHomeStudioId)
              && mayHandOut(r, d.get('role', null))
              && newTrainerStaysHome(d)
              && (madeAsPlaceholder(trainerId, d)
                  || approvesAPendingSignUp(r, t, trainerId, d)));
    }

    // Why: docs/ops/RULES-NOTES.md#madeasplaceholder
    function madeAsPlaceholder(trainerId, d) {
      return d.get('pendingClaim', false) == true
          && trainerId.size() == 20
          && !('authUid' in d);
    }

    function approvesAPendingSignUp(r, t, trainerId, d) {
      return d.get('pendingClaim', false) != true
          && d.get('authUid', trainerId) == trainerId
          && exists(/databases/$(database)/documents/access_requests/$(trainerId))
          && get(/databases/$(database)/documents/access_requests/$(trainerId)).data.get('userId', '') == trainerId
          && get(/databases/$(database)/documents/access_requests/$(trainerId)).data.get('status', '') == 'Pending'
          && trainerLeads(r, t, get(/databases/$(database)/documents/access_requests/$(trainerId)).data.get('requestedStudioId', ''));
    }

    /* A trainer document made by an approver who is not an administrator
       (the franchise partition, Oct 2026): it names its home studio and
       nothing more -- no other studio to work at or be a guest at, the grant
       only for that home, and nothing owned. What the app writes
       (StaffEditor approval, provisional.ts) is exactly this. */
    function newTrainerStaysHome(d) {
      let home = d.primaryHomeStudioId;
      return d.get('managedStudioIds', []).hasOnly([home])
          && (d.get('accessibleStudioIds', null) == null || d.accessibleStudioIds.hasOnly([home]))
          && (d.get('activeGuestStudioIds', null) == null || d.activeGuestStudioIds.size() == 0)
          && d.get('ownedStudioIds', []).size() == 0;
    }

    function isValidTrainer(data) {
      // Trainer PINs were removed in Sep 2026 and `pinHash` is no longer a
      // field anywhere in the app. The refusal stays as a belt: a client that
      // somehow still writes one is refused rather than quietly storing a
      // credential nothing will ever check.
      return !('pinHash' in data) &&
             hasRequiredFields(['fullName', 'initials', 'primaryHomeStudioId']) &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() < 100 &&
             data.initials is string && data.initials.size() >= 2 && data.initials.size() <= 4 &&
             data.primaryHomeStudioId is string && data.primaryHomeStudioId.size() > 0 && data.primaryHomeStudioId.size() < 100 &&
             (!('role' in data) || data.role == null || data.role is string) &&
             (!('accessibleStudioIds' in data) || data.accessibleStudioIds == null || data.accessibleStudioIds is list) &&
             (!('activeGuestStudioIds' in data) || data.activeGuestStudioIds == null || data.activeGuestStudioIds is list) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidClient(data) {
      return hasRequiredFields(['firstName', 'lastName', 'isActive', 'remainingSessions']) &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() < 50 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() < 50 &&
             data.isActive is bool &&
             data.remainingSessions is number && data.remainingSessions >= 0;
    }

    function isValidMachine(data) {
      return hasRequiredFields(['name', 'order']) &&
             data.name is string && data.name.size() > 0 &&
             data.order is number;
    }

    function isValidSession(data) {
      return (!data.keys().hasAll(['sessionNumber']) || data.sessionNumber is number) &&
             (!data.keys().hasAll(['date']) || data.date is string) &&
             (!data.keys().hasAll(['trainerInitials']) || data.trainerInitials is string);
    }

    // Since updates can be partial list updates, we enforce type-safety for incoming fields
    function isValidLog(data) {
      return hasRequiredFields(['sessionId', 'machineId']) &&
             data.sessionId is string &&
             data.machineId is string;
    }

    // Why: docs/ops/RULES-NOTES.md#logtakesitssessionsclient
    function logTakesItsSessionsClient(before, after) {
      return before.get('clientId', null) == null
          && after.get('clientId', null) is string
          && after.clientId.size() > 0
          && get(/databases/$(database)/documents/sessions/$(after.sessionId)).data.get('isUnassigned', false) == true
          && getAfter(/databases/$(database)/documents/sessions/$(after.sessionId)).data.get('clientId', null) == after.clientId
          && getAfter(/databases/$(database)/documents/sessions/$(after.sessionId)).data.get('isUnassigned', true) == false;
    }

    // Why: docs/ops/RULES-NOTES.md#logleavesitsopensessionsclient
    function logLeavesItsOpenSessionsClient(before, after) {
      let session = get(/databases/$(database)/documents/sessions/$(after.sessionId)).data;
      return before.get('clientId', null) is string
          && after.get('clientId', null) == null
          && session.get('isUnassigned', false) == true
          && !(session.get('clientId', null) is string && session.clientId.size() > 0);
    }

    // Why: docs/ops/RULES-NOTES.md#opensessionwriteok
    function openSessionWriteOk(before, after) {
      return (before.get('isUnassigned', false) == true
              || !after.diff(before).affectedKeys().hasAny(['heldSetup']))
          && (before.get('isUnassigned', false) != true
              || !(after.get('clientId', null) is string)
              || after.clientId.size() == 0
              || existsAfter(/databases/$(database)/documents/clients/$(after.clientId)));
    }

    // Why: docs/ops/RULES-NOTES.md#finishonceok
    function finishOnceOk(sessionId, d) {
      let after = getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data;
      return isAuthenticated()
          && d.keys().hasAll(['finishId', 'by', 'at', 'clientId'])
          && d.keys().hasOnly(['finishId', 'by', 'at', 'clientId'])
          && d.finishId is string && d.finishId.size() > 0 && d.finishId.size() <= 64
          && d.by == request.auth.uid
          && d.at == request.time
          && d.clientId is string && d.clientId.size() > 0
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('status', '') != 'Completed'
          && after.get('status', '') == 'Completed'
          && after.get('clientId', '') == d.clientId;
    }

    // Why: docs/ops/RULES-NOTES.md#countedonceok
    function countedOnceOk(before, after) {
      return isAuthenticated()
          && before.by == request.auth.uid
          && !('countedAt' in before)
          && after.diff(before).affectedKeys().hasOnly(['countedAt', 'countedBy'])
          && after.countedAt == request.time
          && after.countedBy == before.finishId;
    }

    function isValidSchedule(data) {
      return hasRequiredFields(['clientName', 'trainerName', 'startTime', 'endTime', 'status', 'serviceName', 'source']);
    }

    function isValidHubAnnouncement(data) {
      return hasRequiredFields(['title', 'shortContent', 'longContent', 'authorId', 'authorName', 'studioId', 'isActive', 'priority']);
    }

    /* A link from an announcement to a page in Learning (Learning + Planner
       round). Mirrors parseLearningRef in src/features/learning/ref.ts. */
    function learningLinkValid(l) {
      return l is map
          && l.keys().hasOnly(['kind', 'id', 'moduleId', 'studioId', 'title'])
          && l.kind in ['machine', 'academy-card', 'academy-script', 'academy-overview',
                        'academy-module', 'academy-topic', 'academy-cueing',
                        'academy-glossary', 'studio-page']
          && (!('id' in l) || (l.id is string && l.id.size() > 0 && l.id.size() <= 200))
          && (!('title' in l) || (l.title is string && l.title.size() <= 160));
    }

    /* catalogSubmissions (My Studio round, Sep 2026). Mirrors
       features/my-studio/floor.ts buildSubmission. */
    function catalogSubmissionValid(d) {
      return d.keys().hasOnly(['studioId', 'studioName', 'machineId', 'definition', 'basedOn',
                               'submittedBy', 'submittedByName', 'note', 'status', 'submittedAt',
                               'decidedBy', 'decidedAt', 'decisionNote', 'publishedAs', 'updatedAt'])
          && d.keys().hasAll(['studioId', 'studioName', 'machineId', 'definition', 'submittedBy',
                              'submittedByName', 'note', 'status'])
          && d.studioId is string && d.studioId.size() > 0 && d.studioId.size() <= 80
          && d.studioName is string && d.studioName.size() <= 80
          && d.machineId is string && d.machineId.size() > 0 && d.machineId.size() <= 120
          && d.definition is map
          && (!('basedOn' in d) || d.basedOn == null || (d.basedOn is string && d.basedOn.size() <= 120))
          && d.submittedByName is string && d.submittedByName.size() <= 80
          && d.note is string && d.note.size() <= 500
          && d.status in ['pending', 'published', 'declined', 'withdrawn'];
    }

    function announcementShapeValid(d) {
      return isValidHubAnnouncement(d)
          && d.title is string && d.title.size() <= 200
          && d.shortContent is string && d.shortContent.size() <= 300
          && (!('learningLink' in d) || learningLinkValid(d.learningLink));
    }

    // Why: docs/ops/RULES-NOTES.md#studionoticeofmine
    function studioNoticeOfMine(r, d) {
      return d.get('targetScope', '') == 'studio'
          && d.get('studioId', '') != '' && d.get('studioId', '') != 'all'
          // The franchise partition (Oct 2026): it reaches that studio only
          // (the bell delivers by targetStudioIds, then targetId).
          && d.get('targetId', d.studioId) == d.studioId
          && d.get('targetStudioIds', [d.studioId]).hasOnly([d.studioId])
          && trainerLeads(r, callerTrainer(), d.studioId);
    }

    /* A network's notice by its franchise owner (the franchise partition,
       Oct 2026): the network named (targetId) is one whose every studio
       they run, and the studios it reaches (targetStudioIds, what the bell
       reads) are all theirs. Written by audience.ts resolveAudience:
       targetScope 'network', targetId the network, studioId '', the
       network's studioIds. One read (the network). */
    function networkNoticeOfMine(r, d) {
      let own = ownStudiosOf(r, callerTrainer());
      return roleIsFranchise(r)
          && d.get('targetScope', '') == 'network'
          && d.get('studioId', '') == ''
          && d.get('targetId', '') is string && d.get('targetId', '') != ''
          && d.get('targetStudioIds', []).size() > 0
          && own.hasAll(d.get('targetStudioIds', []))
          && exists(/databases/$(database)/documents/networks/$(d.targetId))
          && get(/databases/$(database)/documents/networks/$(d.targetId)).data.get('studioIds', []).size() > 0
          && own.hasAll(get(/databases/$(database)/documents/networks/$(d.targetId)).data.get('studioIds', []));
    }

    function hubAnnouncementUpdateAllowed() {
      // The role from the caller's own document (authorityRole; second
      // review): a demoted administrator's claim no longer reaches every
      // notice.
      let r = authorityRole(callerTrainer());
      return (
        (
          // Everyone who was there is still there, and the
          // only name added is the caller's own.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.toSet()
               .hasAll(resource.data.get('readBy', []).toSet())
          && request.resource.data.readBy.toSet()
               .difference(resource.data.get('readBy', []).toSet())
               .hasOnly([request.auth.uid])
        ) || (
          // Administrators change a notice's words (lengths are checked on
          // create only, so a notice written before the limits can still be
          // changed). The author stays who they were.
          roleIsSuper(r)
          && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
          && isValidHubAnnouncement(request.resource.data)
          && (!('learningLink' in request.resource.data)
              || learningLinkValid(request.resource.data.learningLink))
        ) || (
          // Why: docs/ops/RULES-NOTES.md#hubannouncementupdateallowed-body
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive'])
          && request.resource.data.isActive == false
          && (resource.data.get('authorId', '') == request.auth.uid
              || studioNoticeOfMine(r, resource.data)
              || networkNoticeOfMine(r, resource.data))
        )
      );
    }

    // Why: docs/ops/RULES-NOTES.md#hubannouncementcreateallowed
    function hubAnnouncementCreateAllowed() {
      let t = callerTrainer();
      // The role from the caller's own document (authorityRole; second
      // review): a demoted administrator's claim never posts to everyone.
      let r = authorityRole(t);
      let d = request.resource.data;
      // Why: docs/ops/RULES-NOTES.md#hubannouncementcreateallowed-body
      return d.authorId == request.auth.uid
          && announcementShapeValid(d)
          && d.authorName is string && d.authorName.size() <= 120
          && (roleIsSuper(r)
              || (d.authorName == t.get('fullName', '')
                  && (studioNoticeOfMine(r, d) || networkNoticeOfMine(r, d))));
    }

    // ===============================================================
    // COLLECTION ENDPOINTS SECURITY PATHS
    // ===============================================================

    // Why: docs/ops/RULES-NOTES.md#writesderivedtrainerfields
    function writesDerivedTrainerFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['rollups', 'mindbody']);
    }

    // The fields that decide what a person may do and where. A trainer may
    // edit their own document (ownsTrainerDoc) -- their photo, bio, PIN,
    // roster -- but never these: until the cost round (Sep 2026) the
    // self-edit path let anyone hand themselves StudioLeader or FranchiseOwner
    // and any studio, which undid every role check in this file (the hole
    // CLAUDE.md listed as "needs AJ's OK"). Leaders and above still set them
    // for the people they manage, through the other branches of the rule.
    function writesAccessFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'ownedStudioIds', 'accessibleStudioIds', 'activeGuestStudioIds', 'primaryHomeStudioId',
                 'managedStudioIds',
                 // OCT 2 2026: a switched-off account (features/sign-out/
                 // account-off.ts) can't switch itself back on.
                 'isActive', 'switchedOffAt', 'switchedOffBy']);
    }

    /* A role change a caller may make (My Studio round, Sep 2026): none, the
       same role, or one the caller may hand out -- mayHandOut(). Replaces the
       inline "not Founder / Admin / Overseer" clause, which let a studio
       leader promote someone to franchise owner. */
    function roleChangeAllowed(r) {
      return !('role' in request.resource.data)
          || request.resource.data.role == resource.data.get('role', null)
          || mayHandOut(r, request.resource.data.role);
    }

    /* THE STUDIOS A CALLER RUNS, as lists (the franchise partition, Oct 2026).
       ownStudiosOf: their home and owned studios, for the roles that run
       their own (roleRunsOwnStudios) -- trainerLeads's role branch as a list.
       ledStudios: those, and the grant. ownedStudioIds no longer counts for
       a role that does not run its own studios, so the list and trainerLeads
       give one answer. */
    function ownStudiosOf(r, t) {
      return (t != null && roleRunsOwnStudios(r))
          ? [t.get('primaryHomeStudioId', '')].concat(t.get('ownedStudioIds', []))
          : [];
    }

    function ledStudios(r, t) {
      return ownStudiosOf(r, t).concat(t.get('managedStudioIds', []));
    }

    /* A STUDIO LIST, AS A LIST (the franchise partition, Oct 2026): a stored
       null reads as empty, so a document written with null lists can still
       be edited. */
    function idListOf(d, key) {
      return d.get(key, null) == null ? [] : d.get(key, null);
    }

    /* Every studio entering or leaving this list is one the caller runs. */
    function listChangeWithin(before, after, key, led) {
      let b = idListOf(before, key).toSet();
      let a = idListOf(after, key).toSet();
      return a.difference(b).union(b.difference(a)).hasOnly(led);
    }

    /* Every studio this person works at, as a guest or by the grant, is one
       the caller runs (their home is, by the leader branch's own test). */
    function worksOnlyWhereILead(d, led) {
      return idListOf(d, 'accessibleStudioIds').hasOnly(led)
          && idListOf(d, 'activeGuestStudioIds').hasOnly(led)
          && idListOf(d, 'managedStudioIds').hasOnly(led);
    }

    // Why: docs/ops/RULES-NOTES.md#othersdocchangeallowed
    function othersDocChangeAllowed(r, t) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let led = ledStudios(r, t);
      return t != null
          && !changed.hasAny(['ownedStudioIds', 'isActive', 'switchedOffAt', 'switchedOffBy'])
          && (!changed.hasAny(['role', 'email'])
              || (mayHandOut(r, recordRoleOf(resource.data))
                  && idListOf(resource.data, 'ownedStudioIds').size() == 0))
          && (!changed.hasAny(['role']) || roleChangeAllowed(r))
          && (!changed.hasAny(['email']) || worksOnlyWhereILead(resource.data, led))
          && (!changed.hasAny(['primaryHomeStudioId'])
              || led.hasAny([request.resource.data.get('primaryHomeStudioId', '')]))
          && (!changed.hasAny(['accessibleStudioIds'])
              || listChangeWithin(resource.data, request.resource.data, 'accessibleStudioIds', led))
          && (!changed.hasAny(['activeGuestStudioIds'])
              || listChangeWithin(resource.data, request.resource.data, 'activeGuestStudioIds', led))
          && (!changed.hasAny(['managedStudioIds'])
              || listChangeWithin(resource.data, request.resource.data, 'managedStudioIds', led));
    }

    /* A PLACEHOLDER IS MADE, NEVER OPENED (review fix, Oct 2026). A document
       with pendingClaim true can be claimed by whoever signs in with its
       email (selfCreateIsAClaim), and the claim copies its role and every
       studio list, ownedStudioIds included. Only an approver's create and
       an administrator make one; an update by anyone else never turns
       pendingClaim on. The claim's own tombstone (claim.ts tombstone())
       writes supersededByUid, never pendingClaim. */
    function opensAClaim() {
      return request.resource.data.get('pendingClaim', false) == true
          && resource.data.get('pendingClaim', false) != true;
    }

    // Why: docs/ops/RULES-NOTES.md#ownstrainerdoc
    function ownsTrainerDoc(trainerId) {
      return isAuthenticated() && (
        request.auth.uid == trainerId ||
        (
          request.auth.token.email != null &&
          resource.data.get('email', '') != '' &&
          resource.data.email == request.auth.token.email
        )
      );
    }

    function writesForeignRoster(trainerId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['kaizenRoster'])
        && !ownsTrainerDoc(trainerId);
    }

    // Why: docs/ops/RULES-NOTES.md#trainerupdateallowed
    function trainerUpdateAllowed(trainerId, t) {
      let derived = writesDerivedTrainerFields();
      // The caller's role from their own document (authorityRole): a stale
      // claim never edits a trainer document.
      let r = authorityRole(t);
      // Asked once: both branches below turn on it (the budget).
      let own = ownsTrainerDoc(trainerId);
      return
        // Demo Mode: re-seeding rewrites the three demo trainers whole. Both
        // the stored document and the incoming one have to be demo documents,
        // so a real trainer can never be turned into one, nor the reverse.
        // The free literal tests lead, so an ordinary profile edit abandons
        // this clause on its first expression.
        (request.resource.data.get('isDemo', false) == true &&
         trainerId.matches('demo-trainer-.*') &&
         resource.data.get('isDemo', false) == true &&
         t != null &&
         isDemoTrainerPayload(trainerId, request.resource.data)) ||
        (roleIsSuper(r) && !derived) ||
        ( !derived &&
          !writesForeignRoster(trainerId) &&
          !opensAClaim() &&
          // Your own document: never its access fields, whatever your role
          // (only an administrator changes their own -- the clause above).
          // Someone else's: you lead their home studio, and the change is
          // within your reach (othersDocChangeAllowed; the franchise
          // partition, Oct 2026). A franchise owner is no longer a
          // company-wide editor of every trainer.
          ( (own && !writesAccessFields()) ||
            (!own &&
             trainerLeads(r, t, resource.data.get('primaryHomeStudioId', null)) &&
             othersDocChangeAllowed(r, t))
          )
        );
    }

    /* PLANNER NOTES (Learning + Planner round, Sep 2026). The limits match
       src/features/planner/notes/types.ts. These are shape checks on a
       trainer's OWN documents — privacy is the path, below — so a bad write
       from an old app version cannot leave a note the Planner cannot read. */
    function noteKindValid(k) {
      return k in ['note', 'plan', 'routine', 'retention', 'injury', 'research'];
    }

    /* Planner rework (Sep 2026): sources travel with a note; the working log
       and the colleague-share marker live only on the private note. All
       three are optional, so a note written by an older app still passes. */
    function noteExtrasValid(d) {
      return (!('links' in d) || (d.links is list && d.links.size() <= 10))
          && (!('log' in d) || (d.log is list && d.log.size() <= 100))
          && (!('teamShare' in d) || d.teamShare == null || d.teamShare is map);
    }

    function trainerNoteValid(d) {
      return d.keys().hasOnly(['title', 'body', 'kind', 'folderId', 'clientIds', 'clientNames',
                               'pinned', 'sharedWith', 'createdAt', 'updatedAt',
                               'links', 'log', 'teamShare'])
          && noteExtrasValid(d)
          && d.keys().hasAll(['title', 'body', 'kind', 'folderId', 'clientIds', 'clientNames',
                              'pinned', 'sharedWith', 'createdAt', 'updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.body is string && d.body.size() <= 10000
          && noteKindValid(d.kind)
          && (d.folderId == null || (d.folderId is string && d.folderId.size() <= 200))
          && d.clientIds is list && d.clientIds.size() <= 10
          && d.clientNames is map && d.clientNames.size() <= 10
          && d.pinned is bool
          // Shared means about exactly that one client -- the same rule the
          // Planner enforces, so a copy can never carry other clients' names.
          && (d.sharedWith == null || (d.sharedWith is string
                                       && d.clientIds.size() == 1
                                       && d.clientIds[0] == d.sharedWith))
          && d.createdAt is timestamp
          && d.updatedAt is timestamp;
    }

    function noteFolderValid(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.createdAt is timestamp
          && d.updatedAt is timestamp;
    }

    /* A shared note's copy on a client's record. Signed by the caller and
       stamped with this write's time, so neither can be faked; the whole
       document is checked on every write (the app always overwrites it). */
    function sharedNoteValid(d, clientId) {
      return d.keys().hasOnly(['clientId', 'title', 'body', 'kind', 'authorId', 'authorName', 'updatedAt', 'links'])
          && (!('links' in d) || (d.links is list && d.links.size() <= 10))
          && d.keys().hasAll(['clientId', 'title', 'body', 'kind', 'authorId', 'authorName', 'updatedAt'])
          && d.clientId == clientId
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.body is string && d.body.size() <= 10000
          && noteKindValid(d.kind)
          && d.authorId == request.auth.uid
          && d.authorName is string && d.authorName.size() <= 80
          && d.updatedAt == request.time;
    }

    /* A TEAM JOB (Planner rework, Sep 2026). Limits match
       src/features/planner/jobs/types.ts. Shape only: who may write what is
       in the match block. */
    function teamJobValid(d, studioId) {
      return d.studioId == studioId
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && (!('detail' in d) || (d.detail is string && d.detail.size() <= 2000))
          && d.status in ['open', 'done', 'cancelled']
          && d.createdBy is map && d.createdBy.id is string
          && d.assignees is list && d.assignees.size() <= 30
          && d.assigneeIds is list && d.assigneeIds.size() <= 30
          && d.parts is map && d.parts.size() <= 60
          && (!('closingNote' in d) || d.closingNote == null
              || (d.closingNote is string && d.closingNote.size() <= 1000))
          && (!('dueOn' in d) || d.dueOn == null || d.dueOn is string);
    }

    // Why: docs/ops/RULES-NOTES.md#teamjobleaderallowed
    function teamJobLeaderAllowed(studioId) {
      let r = getRole();
      return roleIsSuper(r)
          || trainerLeads(r, callerTrainer(), studioId);
    }

    // Why: docs/ops/RULES-NOTES.md#standingweekshapevalid
    function standingWeekShapeValid(w) {
      return w == null || (w is map
          && w.keys().hasOnly(['hours', 'regulars', 'note'])
          && w.hours is list && w.hours.size() <= 21
          && w.regulars is list && w.regulars.size() <= 80
          && (!('note' in w) || (w.note is string && w.note.size() <= 500)));
    }

    // Why: docs/ops/RULES-NOTES.md#standingweekawayrangevalid
    function standingWeekAwayRangeValid(r) {
      return r.keys().hasOnly(['id', 'from', 'to', 'note'])
          && r.from.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && r.to.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && r.from <= r.to
          && r.id.matches('^[A-Za-z0-9_-]{1,40}$')
          && r.get('note', '').matches('(?s).{0,200}');
    }

    function standingWeekAwayAt(a, i) {
      return a.size() <= i || standingWeekAwayRangeValid(a[i]);
    }

    function standingWeekAwayValid(a) {
      return a == null || (a is list && a.size() <= 6
          && standingWeekAwayAt(a, 0) && standingWeekAwayAt(a, 1)
          && standingWeekAwayAt(a, 2) && standingWeekAwayAt(a, 3)
          && standingWeekAwayAt(a, 4) && standingWeekAwayAt(a, 5));
    }

    function standingWeekValid(d, studioId, trainerUid) {
      return d.keys().hasOnly(['studioId', 'trainerUid', 'trainerId', 'trainerName',
                               'proposed', 'proposedAt', 'proposedBy',
                               'final', 'finalAt', 'finalBy', 'away'])
          && d.studioId == studioId && d.trainerUid == trainerUid
          && d.trainerId is string && d.trainerId.size() > 0 && d.trainerId.size() <= 128
          && d.trainerName is string && d.trainerName.size() <= 120
          && standingWeekShapeValid(d.get('proposed', null))
          && standingWeekShapeValid(d.get('final', null))
          && standingWeekAwayValid(d.get('away', null));
    }

    /* A stamp names whoever wrote it (the Auth uid), and its time is the
       server's. Checked only for the stamps this write changes, so a trainer
       proposing again never has to re-sign the leader's agreement. */
    function standingWeekStampValid(by) {
      return by == null || (by is map && by.id == request.auth.uid
          && by.name is string && by.name.size() <= 120);
    }

    function standingWeekStampsValid(d, changed) {
      return (!changed.hasAny(['proposedBy']) || standingWeekStampValid(d.get('proposedBy', null)))
          && (!changed.hasAny(['finalBy']) || standingWeekStampValid(d.get('finalBy', null)))
          && (!changed.hasAny(['proposedAt']) || d.get('proposedAt', null) == null || d.proposedAt == request.time)
          && (!changed.hasAny(['finalAt']) || d.get('finalAt', null) == null || d.finalAt == request.time);
    }

    // Why: docs/ops/RULES-NOTES.md#coveragewriterallowed
    function coverageWriterAllowed(studioId) {
      let r = getRole();
      let t = callerTrainer();
      return roleIsSuper(r)
          || trainerWorksAt(t, studioId) || trainerLeads(r, t, studioId);
    }

    function coverageMonthDays(month) {
      return [month + '-01', month + '-02', month + '-03', month + '-04', month + '-05',
              month + '-06', month + '-07', month + '-08', month + '-09', month + '-10',
              month + '-11', month + '-12', month + '-13', month + '-14', month + '-15',
              month + '-16', month + '-17', month + '-18', month + '-19', month + '-20',
              month + '-21', month + '-22', month + '-23', month + '-24', month + '-25',
              month + '-26', month + '-27', month + '-28', month + '-29', month + '-30',
              month + '-31'];
    }

    function coverageValid(month, d) {
      return month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && d.keys().hasOnly(['days'])
          && d.days is list
          && d.days.size() > 0 && d.days.size() <= 31
          && d.days.toSet().size() == d.days.size()
          && d.days.hasOnly(coverageMonthDays(month));
    }

    /* MACHINE CARE (Relay, Sep 2026). Shape only; limits match
       src/features/planner/relay/machine-care.ts. Times are millisecond
       numbers (they sit inside merged writes, where serverTimestamp would
       be fine but a number compares in the app without a round trip). */
    function careActorValid(a) {
      return a == null || (a is map && a.id is string && a.name is string && a.name.size() <= 80);
    }
    function machineCareValid(d, machineId) {
      return d.keys().hasOnly(['machineId', 'lastWipedAt', 'lastWipedBy', 'lastDeepCleanAt',
                               'lastDeepCleanBy', 'flag', 'updatedAt'])
          && d.machineId == machineId
          && (!('lastWipedAt' in d) || d.lastWipedAt == null || d.lastWipedAt is number)
          && (!('lastDeepCleanAt' in d) || d.lastDeepCleanAt == null || d.lastDeepCleanAt is number)
          && (!('lastWipedBy' in d) || careActorValid(d.lastWipedBy))
          && (!('lastDeepCleanBy' in d) || careActorValid(d.lastDeepCleanBy))
          && (!('flag' in d) || d.flag == null
              || (d.flag is map
                  && d.flag.note is string && d.flag.note.size() > 0 && d.flag.note.size() <= 500
                  && d.flag.by is map && d.flag.by.id is string
                  && d.flag.at is number
                  /* A new flag is signed by the caller; a wipe merged over
                     someone else's standing flag leaves it as it was. */
                  && (d.flag.by.id == request.auth.uid
                      || (resource != null && resource.data.get('flag', null) == d.flag))));
    }

    /* THE MACHINE-FIT INDEX (machine fit, Sep 2026): who at a studio is set
       to what on one machine. Shape only -- a row is keyed by a client id the
       rules cannot enumerate, so what a write may TOUCH is checked at the
       match block (one row at a time). */
    function machineFitValid(d, studioId, machineId) {
      return d.keys().hasOnly(['machineId', 'studioId', 'rows', 'updatedAt', 'rebuiltAt'])
          && d.machineId == machineId
          && d.studioId == studioId
          // `get`, not `d.rows`: REMOVING a client's row from a machine that
          // has no index document yet creates one with no `rows` at all, and
          // reading a missing property is an error, which refused the write --
          // and, inside the Setup screen's batch, every other row with it.
          && d.get('rows', {}) is map;
    }

    /* A NOTE SHARED WITH COLLEAGUES (Planner rework, Sep 2026). Signed by
       the caller and stamped with this write's time; limits match
       src/features/planner/notes/team-share.ts and notes/types.ts. */
    function noteShareValid(d, studioId, noteId) {
      return d.keys().hasOnly(['noteId', 'studioId', 'authorId', 'authorName', 'title', 'body', 'kind',
                               'links', 'clientIds', 'clientNames', 'audience', 'audienceIds',
                               'expiresOn', 'message', 'updatedAt'])
          && d.keys().hasAll(['noteId', 'studioId', 'authorId', 'authorName', 'title', 'body', 'kind',
                              'links', 'clientIds', 'clientNames', 'audience', 'audienceIds',
                              'expiresOn', 'message', 'updatedAt'])
          && d.noteId == noteId
          && d.studioId == studioId
          && d.authorId == request.auth.uid
          && d.authorName is string && d.authorName.size() <= 80
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.body is string && d.body.size() <= 10000
          && noteKindValid(d.kind)
          && d.links is list && d.links.size() <= 10
          && d.clientIds is list && d.clientIds.size() <= 10
          && d.clientNames is map && d.clientNames.size() <= 10
          && d.audience in ['people', 'team']
          && d.audienceIds is list && d.audienceIds.size() <= 20
          && (d.audience == 'team' || d.audienceIds.size() > 0)
          && (d.expiresOn == null || d.expiresOn is string)
          && d.message is string && d.message.size() <= 300
          && d.updatedAt == request.time;
    }

    /* STUDIO CONTENT WRITES (Learning + Planner round, Sep 2026).
       Someone who works at, or runs, this studio (its franchise owner
       included, the franchise partition, Oct 2026) -- or an administrator.
       Before this round the machine notes, upkeep log,
       playbook and wiki blocks below accepted any signed-in trainer at ANY
       studio (their comments said the path enforced tenancy; nothing checked
       the path). Now the path does. */
    function writesForStudio(studioId) {
      return isSuperAdmin() || isTrainerOfStudio(studioId);
    }

    /* The "Share with all MSF studios" fields on a playbook tip or a machine
       note (features/machine-db). Shape only: whether it may be shared is
       the same question as whether it may be edited. */
    function sharedFieldsValid(d) {
      return (!('shared' in d) || d.shared is bool)
          && (!('sharedKeys' in d) || (d.sharedKeys is list && d.sharedKeys.size() <= 10))
          && (!('studioName' in d) || (d.studioName is string && d.studioName.size() <= 80))
          && (!('shareStatus' in d) || d.shareStatus in ['pending', 'approved', 'declined'])
          && (!('shareReviewNote' in d) || (d.shareReviewNote is string && d.shareReviewNote.size() <= 300));
    }

    // Why: docs/ops/RULES-NOTES.md#sharedecisionok
    function shareDecisionOk() {
      return shareLeftUndecided() || isSuperAdmin();
    }

    function shareLeftUndecided() {
      return (request.resource.data.get('shared', false) != true
              || (resource != null && resource.data.get('shared', false) == true))
          && (request.resource.data.get('shareStatus', 'none') in ['none', 'pending']
              || (resource != null
                  && request.resource.data.get('shareStatus', 'none') == resource.data.get('shareStatus', 'none')))
          && (resource == null
                ? !request.resource.data.keys().hasAny(['shareReviewedBy', 'shareReviewedAt', 'shareReviewNote'])
                : !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['shareReviewedBy', 'shareReviewedAt', 'shareReviewNote']));
    }

    /* Only a studio's OWN machine can be listed in the database (or offered
       for it): a catalog entry is already in it, and a copy adopted from
       another studio is listed by its original. */
    function rosterShareValid(d) {
      return (d.get('shared', false) != true && d.get('shareStatus', 'none') != 'pending')
          || (d.get('source', '') == 'custom' && !('adoptedFrom' in d));
    }

    /* WAVE 2 CODEX: one catalog safety line a studio's copy does without
       (the Sep 21 rule, built Sep 28 2026; AJ: "Yes studios need to be able
       to customize their stuff safety is definitely a worry but are
       trusted"). It must say WHY: at least 3 characters of reason, at most
       300 (lib/machine-template.ts holds the same numbers, and its test
       reads them from here). Who and when travel with it for Compare; the
       app stamps them. */
    function removedLineValid(e) {
      return e is map
          && e.get('reason', '') is string
          && e.get('reason', '').trim().size() >= 3
          && e.get('reason', '').size() <= 300;
    }

    // Why: docs/ops/RULES-NOTES.md#removedsafetyvalid
    function removedSafetyValid(l) {
      return l is list
          && (l.size() < 1 || removedLineValid(l[0]))
          && (l.size() < 2 || removedLineValid(l[1]))
          && (l.size() < 3 || removedLineValid(l[2]))
          && (l.size() < 4 || removedLineValid(l[3]))
          && (l.size() < 5 || removedLineValid(l[4]))
          && (l.size() < 6 || removedLineValid(l[5]))
          && (l.size() < 7 || removedLineValid(l[6]))
          && (l.size() < 8 || removedLineValid(l[7]))
          && (l.size() < 9 || removedLineValid(l[8]))
          && (l.size() < 10 || removedLineValid(l[9]));
    }

    /* WAVE 2 CODEX: the Codex fields on a roster entry (Sep 28 2026). The
       unit's model, when named, is a model id (machineModels/{id}), set by
       the studio's leaders; and a removed catalog safety line carries a
       reason (the Sep 21 rule: a removed safety line without one is
       refused). Pure map lookups: no document is read, so the roster rule
       asks this before anything that calls get(). */
    function rosterCodexValid(d) {
      return (!('modelId' in d)
              || (d.modelId is string && d.modelId.size() > 0 && d.modelId.size() <= 100))
          && removedSafetyValid(d.get('overrides', {}).get('removedSafety', []));
    }

    /* ...and a copy stays a copy: an update can't drop `adoptedFrom` and list
       it in the same write (review fix). The studio it names is the one its
       path names, so a shared machine can't claim another studio. */
    function rosterWriteValid(studioId) {
      return rosterShareValid(request.resource.data)
          && request.resource.data.get('studioId', studioId) == studioId
          && (resource == null
              || !('adoptedFrom' in resource.data)
              || request.resource.data.get('shared', false) != true)
          && shareDecisionOk();
    }

    // Why: docs/ops/RULES-NOTES.md#rosteroutofserviceok
    function rosterOutOfServiceOk() {
      return !('outOfService' in request.resource.data)
          || (resource != null
              && 'outOfService' in resource.data
              && request.resource.data.outOfService == resource.data.outOfService)
          || outOfServiceValid(request.resource.data.outOfService);
    }

    // WAVE 2 CATALOG: the shape of one Out of service record, signed.
    function outOfServiceValid(o) {
      return o is map
          && o.keys().hasOnly(['reason', 'by', 'at'])
          && o.keys().hasAll(['reason', 'by', 'at'])
          && o.reason is string
          && o.reason.size() > 0
          && o.reason.size() <= 140
          && o.by is map
          && o.by.keys().hasOnly(['uid', 'name'])
          && o.by.keys().hasAll(['uid', 'name'])
          && o.by.uid == request.auth.uid
          && o.by.name is string
          && o.by.name.size() <= 100
          && o.at == request.time;
    }

    /* A comment on a Learning page (features/comments). No client field
       exists to fill: hasOnly is the guard, as on the playbook and wiki. */
    function commentValid(d, studioId) {
      return d.keys().hasOnly(['studioId', 'targetKey', 'target', 'body', 'authorId',
                               'authorName', 'mentions', 'createdAt', 'editedAt'])
          && d.keys().hasAll(['studioId', 'targetKey', 'target', 'body', 'authorId',
                              'authorName', 'mentions', 'createdAt'])
          && d.studioId == studioId
          && d.targetKey is string && d.targetKey.size() > 0 && d.targetKey.size() <= 300
          && d.target is map
          && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
          && d.authorId is string
          && d.authorName is string && d.authorName.size() <= 80
          && d.mentions is list && d.mentions.size() <= 10
          && d.createdAt is timestamp;
    }

    match /trainers/{trainerId} {
      allow read: if isAuthenticated();

      // A TRAINER'S COUNTERS (the cost plan, Sep 26 2026, D3c): sessions
      // coached, the rolling windows. Beside the trainer document rather than
      // on it, so a completed session is not sent to every iPad in the
      // company. Read as the trainer is; written only by the Cloud Functions
      // (functions/src/trainerRollups.ts), which these rules do not govern.
      match /stats/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
      allow create: if isAuthenticated() && 
                    request.resource.data.primaryHomeStudioId != null &&
                    isValidTrainer(request.resource.data) &&
                    (// An administrator, or an approval by someone who runs
                     // the new person's studio (approverCreateAllowed: the
                     // role resolved once, from the approver's own document;
                     // the franchise partition, Oct 2026).
                     approverCreateAllowed(trainerId, request.resource.data) ||
                     // Bootstrap / claim: a person may own trainers/{their uid},
                     // but may not hand themselves Admin, Founder or Overseer
                     // (selfCreatedRoleIsAllowed), and since Oct 3 2026 only
                     // as the owner's bootstrap or a claim of a placeholder
                     // someone else set up -- never with studios of their own
                     // choosing. See selfCreateIsAClaim() above.
                     (request.auth.uid == trainerId && selfCreatedRoleIsAllowed() &&
                      (isOwnerBootstrap() || selfCreateIsAClaim(trainerId))) ||
                     // Demo Mode (Sep 20 2026). The seeder's three demo
                     // trainers have no Auth account, so they cannot be minted
                     // by the bootstrap clause above, and the studio they join
                     // has no leaders of its own to approve them. Pinned hard
                     // by isDemoTrainerPayload -- see the demo helpers.
                     (isAnyAuthenticatedTrainer() &&
                      isDemoTrainerPayload(trainerId, request.resource.data)));
      allow update: if isAuthenticated() &&
                       trainerUpdateAllowed(trainerId, callerTrainer());
      allow delete: if isSuperAdmin();

      match /secrets/account {
        allow read: if isSuperAdmin() || request.auth.uid == trainerId || 
            (exists(/databases/$(database)/documents/trainers/$(trainerId)) && 
             isStudioOwnerOrHeadTrainer(get(/databases/$(database)/documents/trainers/$(trainerId)).data.primaryHomeStudioId));
        allow write: if isSuperAdmin() || request.auth.uid == trainerId || 
            (exists(/databases/$(database)/documents/trainers/$(trainerId)) && 
             isStudioOwnerOrHeadTrainer(get(/databases/$(database)/documents/trainers/$(trainerId)).data.primaryHomeStudioId));
      }

      // Why: docs/ops/RULES-NOTES.md#trainers-trainerid-tasktemplates-templateid
      match /taskTemplates/{templateId} {
        allow read, write: if isAuthenticated() && request.auth.uid == trainerId;
      }

      match /taskInstances/{instanceId} {
        allow read, write: if isAuthenticated() && request.auth.uid == trainerId;
      }

      // PLANNER NOTES (Learning + Planner round, Sep 2026) -- a trainer's own
      // notes and folders. Private by PATH, for the same reason as the task
      // lists above, and more so: a note can name a client and describe an
      // injury. Nobody else reads these, a studio owner included. A note the
      // author wants the team to see is COPIED onto the client's record
      // (clients/{id}/sharedNotes, below); this tree never opens up.
      match /notes/{noteId} {
        allow read, delete: if isAuthenticated() && request.auth.uid == trainerId;
        allow create, update: if isAuthenticated() && request.auth.uid == trainerId
                              && trainerNoteValid(request.resource.data);
      }

      match /noteFolders/{folderId} {
        allow read, delete: if isAuthenticated() && request.auth.uid == trainerId;
        allow create, update: if isAuthenticated() && request.auth.uid == trainerId
                              && noteFolderValid(request.resource.data);
      }

      // Why: docs/ops/RULES-NOTES.md#trainers-trainerid-notifications-notificationid
      match /notifications/{notificationId} {
        allow read, update, delete:
          if isAuthenticated() && request.auth.uid == trainerId;

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.actor.id == request.auth.uid
                      && request.resource.data.kind is string
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 200
                      && request.resource.data.readAt == null;
      }

    }

    // ===============================================================
    // WAVE 2 RELAY (Sep 28 2026, AJ: "all yes") -- the Relay room's
    // second wave. Each block below is its own, so it can be read, tested
    // and reverted alone; every one keeps its cheap field checks before
    // anything that reads a document. Tests: "wave 2 relay" in
    // tests/firestore.rules.test.ts. Round: docs/rounds/2026-09-28-relay-2.md.
    // ===============================================================

    // WAVE 2 RELAY: the last-seen marker. studios/{studioId}/lastSeen/{uid}
    // -- when this trainer last opened Relay's Board at this studio, so
    // "Since you were in" knows what is new. Read and written by that
    // person only (the uid is the path): nobody else can see when someone
    // was in. Two server times and nothing else.
    // features/relay/board/last-seen.ts.
    match /studios/{studioId}/lastSeen/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create, update: if isAuthenticated() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['at', 'updatedAt'])
                            && request.resource.data.at == request.time
                            && request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // Why: docs/ops/RULES-NOTES.md#trainers-trainerid-notes-noteid
    match /trainers/{trainerId}/notes/{noteId} {
      function journalFieldsValid(d) {
        return (!('noteType' in d) || d.noteType == null
                  // 'team': a leader's note about a team member (Oct 2 2026).
                  || d.noteType in ['client', 'machine', 'protocol', 'research', 'trend', 'personal', 'team'])
            && (!('fields' in d) || d.fields == null || (d.fields is map && d.fields.size() <= 3))
            && (!('hunch' in d) || d.hunch == null
                || (d.hunch is map
                    && d.hunch.keys().hasOnly(['claim', 'how', 'need', 'unit', 'evidence', 'retiredAt'])
                    && d.hunch.get('claim', '') is string && d.hunch.get('claim', '').size() <= 500
                    && d.hunch.get('how', '') is string && d.hunch.get('how', '').size() <= 1000
                    && d.hunch.get('need', 1) is int && d.hunch.get('need', 1) >= 1 && d.hunch.get('need', 1) <= 50
                    && d.hunch.get('unit', 'clients') in ['clients', 'sessions']
                    && d.hunch.get('evidence', []) is list && d.hunch.get('evidence', []).size() <= 60
                    && (d.hunch.get('retiredAt', null) == null || d.hunch.get('retiredAt', null) is number)));
      }
      function journalNoteValid(d) {
        return d.keys().hasOnly(['title', 'body', 'kind', 'folderId', 'clientIds', 'clientNames',
                                 'pinned', 'sharedWith', 'createdAt', 'updatedAt',
                                 'links', 'log', 'teamShare', 'noteType', 'fields', 'hunch'])
            && noteExtrasValid(d)
            && d.keys().hasAll(['title', 'body', 'kind', 'folderId', 'clientIds', 'clientNames',
                                'pinned', 'sharedWith', 'createdAt', 'updatedAt'])
            && d.title is string && d.title.size() > 0 && d.title.size() <= 160
            && d.body is string && d.body.size() <= 10000
            && noteKindValid(d.kind)
            && (d.folderId == null || (d.folderId is string && d.folderId.size() <= 200))
            && d.clientIds is list && d.clientIds.size() <= 10
            && d.clientNames is map && d.clientNames.size() <= 10
            && d.pinned is bool
            && (d.sharedWith == null || (d.sharedWith is string
                                         && d.clientIds.size() == 1
                                         && d.clientIds[0] == d.sharedWith))
            && d.createdAt is timestamp
            && d.updatedAt is timestamp
            && journalFieldsValid(d);
      }
      allow create, update: if isAuthenticated() && request.auth.uid == trainerId
                            && journalNoteValid(request.resource.data);
    }

    // WAVE 2 RELAY: the day log. studios/{studioId}/dayLogs/{uid}_{day} --
    // a trainer's own record of one day at one studio: Opening's things to
    // carry today, Close out's facts and one line for yourself. Read and
    // written only by the person whose uid starts the id (and is in `uid`);
    // a list must ask for `uid == me` (index: dayLogs uid, day desc). Never
    // shown to leaders, never counted. features/relay/notes/day-log.ts.
    match /studios/{studioId}/dayLogs/{logId} {
      function dayLogValid(d) {
        return d.keys().hasOnly(['uid', 'studioId', 'day', 'facts', 'carry', 'line', 'createdAt', 'updatedAt'])
            && d.uid == request.auth.uid
            && d.studioId == studioId
            && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && logId == request.auth.uid + '_' + d.day
            && (!('facts' in d) || (d.facts is list && d.facts.size() <= 12))
            && (!('carry' in d) || (d.carry is list && d.carry.size() <= 3))
            && (!('line' in d) || d.line == null
                || (d.line is map
                    && d.line.keys().hasOnly(['what', 'soWhat', 'nowWhat'])
                    && d.line.get('what', '') is string && d.line.get('what', '').size() <= 500
                    && d.line.get('soWhat', '') is string && d.line.get('soWhat', '').size() <= 500
                    && d.line.get('nowWhat', '') is string && d.line.get('nowWhat', '').size() <= 500))
            && d.updatedAt == request.time;
      }
      allow get: if isAuthenticated() && logId.split('_')[0] == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update: if isAuthenticated() && dayLogValid(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Why: docs/ops/RULES-NOTES.md#clients-clientid
    match /clients/{clientId} {
      allow read: if isSuperAdmin()
                  || (isAnyAuthenticatedTrainer()
                      && isTrainerOfClientData(
                           clientId,
                           resource.data,
                           getTrainerData().primaryHomeStudioId,
                           getTrainerData().get('accessibleStudioIds', []),
                           getTrainerData().get('activeGuestStudioIds', [])));

      // `renewal` is the renewal snapshot (Renewals round, Sep 2026). Only
      // the nightly job writes it, through the Admin SDK, which these rules
      // do not govern. Nobody writes it from the app — not even an admin — so
      // an iPad holding an old copy of the client can never put it back.
      allow create: if isValidClient(request.resource.data)
                    && !('renewal' in request.resource.data)
                    && (isSuperAdmin()
                        || (isAnyAuthenticatedTrainer()
                            && isTrainerOfStudio(
                                 getStudioIdFromData(request.resource.data))
                            && clientCreateHonest(clientId, request.resource.data)));

      // Why: docs/ops/RULES-NOTES.md#clients-clientid-allow-update
      allow update: if isValidClient(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['renewal'])
                    && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['machineStatsBackfilledAt'])
                         && 'machineStatsBackfilledAt' in request.resource.data)
                    && (isSuperAdmin()
                        || crossTrainSessionTotals(resource.data, callerTrainer())
                        || (isAnyAuthenticatedTrainer()
                            && getStudioIdFromData(request.resource.data) == getStudioIdFromData(resource.data)
                            && isTrainerOfStudio(
                                 getStudioIdFromData(resource.data))));

      allow delete: if isSuperAdmin();
    }

    // INBODY SCANS (Renewals round, Sep 2026) -- see the helpers above.
    //
    // Anyone who can write the client can add a scan or correct a typo in
    // one (the correction is signed: updatedBy). Who entered it, when, and
    // from where never change. A scan entered by mistake can be removed by
    // whoever entered it or by the studio's leaders.
    match /clients/{clientId}/inbodyScans/{scanId} {
      allow read: if isAuthenticated() && (
                    roleIsSuper(getRole()) ||
                    sessionClientIsReadable(clientId, getRole(), callerTrainer()));

      allow create: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer())
                    && inbodyScanValid(request.resource.data)
                    && request.resource.data.enteredBy == request.auth.uid
                    && request.resource.data.enteredByName is string
                    && request.resource.data.enteredByName.size() <= 80
                    && request.resource.data.source in ['manual', 'photo']
                    && request.resource.data.studioId is string
                    && request.resource.data.createdAt == request.time;

      allow update: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer())
                    && inbodyScanValid(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['enteredBy', 'enteredByName', 'createdAt', 'source', 'studioId'])
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer()) && (
                      resource.data.get('enteredBy', '') == request.auth.uid ||
                      isSuperAdmin() ||
                      isStudioOwnerOrHeadTrainerOnly(inbodyClientStudio(clientId)));
    }

    // Why: docs/ops/RULES-NOTES.md#clients-clientid-sharednotes-noteid
    match /clients/{clientId}/sharedNotes/{noteId} {
      allow read: if isAuthenticated() && (
                    roleIsSuper(getRole()) ||
                    sessionClientIsReadable(clientId, getRole(), callerTrainer()));

      allow create: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer())
                    && sharedNoteValid(request.resource.data, clientId);

      allow update: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer())
                    && resource.data.get('authorId', '') == request.auth.uid
                    && sharedNoteValid(request.resource.data, clientId);

      allow delete: if isAuthenticated() && (
                      resource == null ||
                      resource.data.get('authorId', '') == request.auth.uid ||
                      isSuperAdmin() ||
                      isStudioOwnerOrHeadTrainerOnly(inbodyClientStudio(clientId)));
    }

    // Why: docs/ops/RULES-NOTES.md#machinetotalsclient
    function machineTotalsClient(clientId) {
      return get(/databases/$(database)/documents/clients/$(clientId)).data;
    }

    function machineTotalsVisitor(c, t) {
      return t != null
        && (c.get('approvedCrossTrainStudioIds', []).hasAny([t.get('primaryHomeStudioId', '')])
            || c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('accessibleStudioIds', []))
            || c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('activeGuestStudioIds', [])))
        && (resource == null
              ? request.resource.data.keys()
              : request.resource.data.diff(resource.data).affectedKeys())
             .hasOnly(['currentMachineMetrics', 'machineStats', 'updatedAt']);
    }

    function machineTotalsWritable(clientId) {
      return exists(/databases/$(database)/documents/clients/$(clientId))
        && (isSuperAdmin()
            || machineTotalsVisitor(machineTotalsClient(clientId), callerTrainer())
            || (isAnyAuthenticatedTrainer()
                && isTrainerOfStudio(getStudioIdFromData(machineTotalsClient(clientId)))));
    }

    match /clients/{clientId}/machineTotals/{docId} {
      allow read: if docId == 'current' && (
                    isSuperAdmin()
                    || (isAnyAuthenticatedTrainer()
                        && exists(/databases/$(database)/documents/clients/$(clientId))
                        && isTrainerOfClientData(
                             clientId,
                             machineTotalsClient(clientId),
                             getTrainerData().primaryHomeStudioId,
                             getTrainerData().get('accessibleStudioIds', []),
                             getTrainerData().get('activeGuestStudioIds', []))));

      allow create, update: if docId == 'current'
                    && request.resource.data.keys().hasOnly(
                         ['currentMachineMetrics', 'machineStats', 'machineStatsBackfilledAt', 'updatedAt', 'isDemo'])
                    && machineTotalsWritable(clientId);

      allow delete: if isSuperAdmin();
    }

    // Why: docs/ops/RULES-NOTES.md#clientmachinesettings-settingid
    match /clientMachineSettings/{settingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // Why: docs/ops/RULES-NOTES.md#machines-machineid
    match /machines/{machineId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin();
      allow delete: if false;

      // Why: docs/ops/RULES-NOTES.md#machines-machineid-settinghistory-historyid
      match /settingHistory/{historyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
        allow update, delete: if false;
      }

      // Why: docs/ops/RULES-NOTES.md#machinechangevalid
      function machineChangeValid(d) {
        return d.keys().hasOnly(['at', 'by', 'kind', 'fields'])
            && d.keys().hasAll(['at', 'by', 'kind', 'fields'])
            && d.at == request.time
            && d.by is map && d.by.keys().hasOnly(['uid', 'name']) && d.by.keys().hasAll(['uid', 'name'])
            && d.by.uid == request.auth.uid
            && d.by.name is string && d.by.name.size() > 0 && d.by.name.size() <= 120
            && d.kind in ['created', 'edited']
            && d.fields is list && d.fields.size() <= 80;
      }
      match /changes/{changeId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isSuperAdmin() && machineChangeValid(request.resource.data);
        allow update, delete: if false;
      }
    }

    // WAVE 2 CODEX: the model record (Codex R2, Sep 28 2026; AJ approved
    // the Codex's new data "all yes"). A maker's model of an MSF movement —
    // "Hoist ROC-IT Leg Press" — its dials and stacks, written once and
    // pointed at by each studio's unit (roster entry `modelId`). The shape is
    // exactly features/machine-codex/models.ts's `modelDocument` plus the
    // stamp: the Catalog's model tier reads it. Written whole (setDoc, no
    // merge), so every write carries the stamp and the rule can pin it.
    function machineModelValid(d) {
      return d.keys().hasOnly(['brand', 'model', 'movementId', 'dials', 'notes', 'updatedAt', 'updatedBy'])
          && d.keys().hasAll(['brand', 'model', 'movementId', 'updatedAt', 'updatedBy'])
          && d.brand is string && d.brand.size() > 0 && d.brand.size() <= 60
          && d.model is string && d.model.size() > 0 && d.model.size() <= 80
          && d.movementId is string && d.movementId.size() > 0 && d.movementId.size() <= 100
          && (!('dials' in d) || (d.dials is list && d.dials.size() <= 20))
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
          && d.updatedAt == request.time
          && d.updatedBy == request.auth.uid;
    }

    // WAVE 2 CODEX: everyone signed in reads the models (a unit's model is
    // named on the floor); administrators write them. The shape is checked
    // first — map lookups, no document read — and isSuperAdmin() last, so a
    // malformed write is refused before the role is ever looked up. Never
    // deleted: a unit may name it, and the weekly job pools by its id.
    match /machineModels/{modelId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
                             && machineModelValid(request.resource.data)
                             && isSuperAdmin();
      allow delete: if false;
    }

    match /machineSettingChanges/{changeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // ROUTINES & ADJUSTMENTS
    match /routines/{routineId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      // Administrators only (the franchise partition, second review): any
      // trainer may rewrite a routine's clientId on update, so the stored
      // client can't decide a delete. No app path deletes a routine. The
      // privacy round pins clientId and brings a franchise owner's back.
      allow delete: if isSuperAdmin();

      // Why: docs/ops/RULES-NOTES.md#planchangeok
      function planChangeOk(d) {
        return d.keys().hasAll(['kind', 'machineIds', 'byUid', 'at'])
          && d.keys().hasOnly(['kind', 'machineIds', 'reason', 'value', 'byUid', 'byName', 'at'])
          && d.kind in ['start', 'add', 'remove', 'swap', 'reorder', 'purpose', 'building', 'focus',
                        'cantdo', 'cando', 'replan', 'column']
          && d.machineIds is list && d.machineIds.size() <= 30
          && d.byUid == request.auth.uid
          && d.at == request.time
          && (!('reason' in d) || (d.reason is string && d.reason.size() <= 500))
          && (!('value' in d) || (d.value is string && d.value.size() <= 500))
          && (!('byName' in d) || (d.byName is string && d.byName.size() <= 120));
      }

      match /planChanges/{changeId} {
        allow read: if isAuthenticated();
        allow create: if isAnyAuthenticatedTrainer() && planChangeOk(request.resource.data);
        allow update, delete: if false;
      }
    }

    match /routineAdjustments/{adjustmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // Why: docs/ops/RULES-NOTES.md#presettier
    function presetTier(data) {
      return data.get('tier', 'trainer');
    }

    function canWritePreset(data) {
      return (presetTier(data) == 'company' && isSuperAdmin()) ||
             (presetTier(data) == 'studio' && (
                isSuperAdmin() ||
                isStudioOwnerOrHeadTrainer(data.get('studioId', ''))
             )) ||
             (presetTier(data) == 'trainer' && isAnyAuthenticatedTrainer());
    }

    match /routinePresets/{presetId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canWritePreset(request.resource.data);
      allow update: if isAuthenticated() &&
                       canWritePreset(resource.data) &&
                       canWritePreset(request.resource.data);
      allow delete: if isAuthenticated() && canWritePreset(resource.data);
    }

    // Why: docs/ops/RULES-NOTES.md#studiomachinesettings-settingid
    match /studioMachineSettings/{settingId} {
      allow read: if isAuthenticated() && writesForStudio(resource.data.studioId);
      allow create: if isAuthenticated()
                    && request.resource.data.studioId is string
                    && request.resource.data.machineId is string
                    && settingId == request.resource.data.studioId + '_' + request.resource.data.machineId
                    && (isSuperAdmin() || isStudioOwnerOrHeadTrainer(request.resource.data.studioId));
      allow update: if isAuthenticated()
                    && request.resource.data.studioId == resource.data.studioId
                    && request.resource.data.get('machineId', '') == resource.data.get('machineId', '')
                    && (isSuperAdmin() || isStudioOwnerOrHeadTrainer(resource.data.studioId));
      allow delete: if isAuthenticated()
                    && (isSuperAdmin() || isStudioOwnerOrHeadTrainer(resource.data.studioId));
    }

    // Why: docs/ops/RULES-NOTES.md#sessions-sessionid
    match /sessions/{sessionId} {
      // Caller resolved ONCE and passed down; see the expression-budget
      // helpers above. Same policy as before, ~1/10th the expression count.
      allow read: if isAuthenticated()
                  && sessionIsReadable(resource.data, getRole(), callerTrainer());

      allow create: if isValidSession(request.resource.data)
                    && (isSuperAdmin()
                        || (isAnyAuthenticatedTrainer()
                            && (isTrainerOfStudio(
                                  request.resource.data.get('hostedAtStudioId', ''))
                                || namedClientIsReadable(
                                     request.resource.data.get('clientId', '')))));

      allow update: if isValidSession(request.resource.data)
                    && openSessionWriteOk(resource.data, request.resource.data)
                    && (isSuperAdmin()
                        || (isAnyAuthenticatedTrainer()
                            && (resource.data.get('trainerId', '') == request.auth.uid
                                || isTrainerOfStudio(
                                     resource.data.get('hostedAtStudioId', ''))
                                || namedClientIsReadable(
                                     resource.data.get('clientId', '')))));

      /* Deleting a session is the same reach as editing one (Sep 17 2026).
         It was super-admin-and-owner only, which meant a trainer who logged a
         past session onto the wrong client could not take it back off, and the
         History tab's Delete button failed halfway through its batch. Same
         three tests as `update`, read off the STORED document. */
      allow delete: if isSuperAdmin()
                    || (isAnyAuthenticatedTrainer()
                        && (resource.data.get('trainerId', '') == request.auth.uid
                            || isTrainerOfStudio(
                                 resource.data.get('hostedAtStudioId', ''))
                            || namedClientIsReadable(
                                 resource.data.get('clientId', ''))));

      // The logs hang off a session whose parent rule has already been
      // evaluated to reach this path in the UI, but a client can address them
      // directly, so they carry the same client check rather than trusting it.
      match /logs/{logId} {
        allow read, write: if isSuperAdmin()
                           || (isAnyAuthenticatedTrainer()
                               && isTrainerOfSessionId(sessionId));
      }

      // Why: docs/ops/RULES-NOTES.md#sessions-finish-once
      match /finish/{docId} {
        allow read: if isSuperAdmin()
                    || (isAuthenticated()
                        && ((resource != null && resource.data.by == request.auth.uid)
                            || (isAnyAuthenticatedTrainer() && isTrainerOfSessionId(sessionId))));
        allow create: if docId == 'once' && finishOnceOk(sessionId, request.resource.data);
        allow update: if docId == 'once' && countedOnceOk(resource.data, request.resource.data);
        allow delete: if isSuperAdmin();
      }
    }

    // EXERCISE LOGS — KEY FIX: Any authenticated trainer can write exercise logs
    match /exerciseLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer() && isValidLog(request.resource.data);
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer() && isValidLog(request.resource.data) && (
        resource.data.get('sessionId', null) == request.resource.data.get('sessionId', null) && (
          resource.data.get('clientId', null) == request.resource.data.get('clientId', null)
          || logTakesItsSessionsClient(resource.data, request.resource.data)
          || logLeavesItsOpenSessionsClient(resource.data, request.resource.data)
        )
      );
      /* HISTORY EDITING (Sep 17 2026). Taking a machine off a session that
         already happened means deleting its set, and only a super admin or a
         franchise owner could — so "remove this machine", and the History
         tab's own Delete Session, both failed for the people who work the
         floor. The update rule above already lets any signed-in trainer blank
         any log, so delete grants no reach update did not; it just stops
         leaving an empty row behind where a machine used to be. */
      allow delete: if isSuperAdmin()
                    || (isAuthenticated() && isAnyAuthenticatedTrainer());
    }

    // CALENDAR SCHEDULES
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        isAnyAuthenticatedTrainer()
      ) && isValidSchedule(request.resource.data);
      allow delete: if isSuperAdmin() || isAnyAuthenticatedTrainer();
    }
    
    // CLINICAL NOTES
    match /sessionNotes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      // Administrators only, as routines (the franchise partition): any
      // trainer may rewrite clientId on update.
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read, write: if isSuperAdmin() || request.auth.uid == userId;
    }

    
    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // Written by the weekly machine-trends job (server/machine-trends-job.ts,
    // service account, bypasses these rules). Aggregates only - never a
    // client row - so it is readable like exerciseLogs, by any signed-in user.
    // The old leaderboards/* documents are no longer written; the block
    // stays so the stale documents can still be deleted from the console.
    match /machineTrends/{machineId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // THE KAIZEN REPORT (machine fit, Sep 2026) -- the weekly job's company-wide
    // view of how each machine is set up: every studio beside the company, and
    // how many of a studio's set-ups sit far from what similar clients use.
    // That is management information about named studios, so unlike
    // machineTrends it is for administrators, founders and overseers only.
    // Counts only, never a client row. Written by the job (Admin SDK).
    match /kaizenReports/{machineId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /leaderboards/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // SPECIAL ATHLETE FOCUS PATTERNS
    // The three deletes below are administrators' (the franchise partition,
    // second review): any trainer may rewrite clientId on update, so the
    // stored client can't decide a delete. The privacy round pins clientId
    // and brings a franchise owner's back.
    match /trainerFocuses/{focusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isSuperAdmin();
    }

    match /progressReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isSuperAdmin();
    }

    match /focusRecords/{focusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // UNIFIED COACHING JOURNAL (Sep 2026)
    // ===============================================================
    // Why: docs/ops/RULES-NOTES.md#journalentries-entryid
    match /journalEntries/{entryId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.clientId is string
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 5000
                    && request.resource.data.authorId == request.auth.uid;

      // authorId and clientId are immutable after creation.
      allow update: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.body.size() <= 5000;

      // Administrators, and the franchise owner of the client's studio (the
      // franchise partition, Oct 2026): clientId is pinned by the update
      // rule above, so the stored client is the true one.
      allow delete: if isSuperAdmin()
                    || (isAuthenticated() && franchiseRunsClient(resource.data.get('clientId', '')));
    }

    // Why: docs/ops/RULES-NOTES.md#notedismissals-uid
    match /noteDismissals/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Why: docs/ops/RULES-NOTES.md#path-ford-fordid
    match /{path=**}/ford/{fordId} {
      allow read: if isAuthenticated()
                  && isAnyAuthenticatedTrainer()
                  && (
                       isSuperAdmin()
                       // A franchise owner reads the studios they run through
                       // isTrainerOfStudio (the franchise partition, Oct 2026).
                       || isTrainerOfStudio(resource.data.studioId)
                     );

      // pillar is deliberately NOT validated as one of the four letters: null
      // is the floor path. A trainer mid-set types the sentence and saves, and
      // the category is chosen at teardown. Requiring it here would put a
      // decision between hearing the thing and recording it.
      allow create: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.clientId is string
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 2000
                    && request.resource.data.authorId == request.auth.uid
                    && isTrainerOfStudio(request.resource.data.studioId);

      // clientId and studioId are immutable: a detail cannot be moved to
      // another client or walked out of its studio by an update.
      allow update: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.studioId == resource.data.studioId
                    && request.resource.data.body.size() <= 2000
                    && (
                         isSuperAdmin()
                         || isTrainerOfStudio(resource.data.studioId)
                       );

      // Details are archived, not deleted — see ford-write.ts. The one
      // exception is a capture discarded before it was ever filed, which is
      // why the author keeps a delete on an untagged entry of their own. A
      // franchise owner deletes at the studios they run (the franchise
      // partition, Oct 2026).
      allow delete: if isSuperAdmin()
                    || (isAuthenticated() && franchiseRunsStudio(resource.data.get('studioId', '')))
                    || (
                         isAnyAuthenticatedTrainer()
                         && resource.data.authorId == request.auth.uid
                         && resource.data.pillar == null
                       );
    }

    // TRAINER FOCUSES — a trainer's standing intent for a client.
    // Only the owning trainer (or a manager) may pass, extend or retire a
    // focus; anyone can read them, because every coach in the room needs to
    // know what their colleagues are working on with this client.
    match /clientFocuses/{focusId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.clientId is string
                    && request.resource.data.trainerId == request.auth.uid
                    && request.resource.data.category in ['Posture', 'Path', 'Pace', 'Purpose'];

      allow update: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.trainerId == resource.data.trainerId
                    && (
                         resource.data.trainerId == request.auth.uid
                         || isSuperAdmin()
                         // The franchise owner of the STORED client's studio
                         // (the franchise partition, Oct 2026): a non-author
                         // can't re-point clientId first.
                         || franchiseRunsClient(resource.data.get('clientId', ''))
                       );

      allow delete: if isSuperAdmin()
                    || (isAuthenticated() && franchiseRunsClient(resource.data.get('clientId', '')));
    }

    // STUDIOS: Territory configurations
    match /studios/{studioId} {
      allow read: if isAuthenticated();
      // Why: docs/ops/RULES-NOTES.md#studios-studioid-allow-create
      allow create: if superOnRecord() || (hasRunOfDemo(studioId) && demoStudioStaysDemo());
      allow update: if superOnRecord() ||
                       (isStudioOwnerOrHeadTrainer(studioId) &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['autoSyncEnabled', 'syncIntervalMinutes']) &&
                        ((isDemoStudioId(studioId) && demoStudioStaysDemo()) ||
                         (!isDemoStudioId(studioId) &&
                          !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['networkId', 'ownerId', 'mindbodySiteId', 'mindbodyLocationId', 'isDemo'])))) ||
                       (isAnyAuthenticatedTrainer() && writesForStudio(studioId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['lastScheduleSyncAt', 'scheduleSyncFailures', 'lastDeepScheduleSyncAt']));
      allow delete: if isSuperAdmin();

      // Why: docs/ops/RULES-NOTES.md#demostudiostaysdemo
      function demoStudioStaysDemo() {
        let d = request.resource.data;
        return !d.keys().hasAny(['mindbodySiteId', 'mindbodyLocationId', 'networkId'])
            && d.get('isDemo', false) == true
            && d.get('mindbodyMode', 'offline') == 'offline';
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-sync-docid
      match /sync/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAnyAuthenticatedTrainer()
                    && writesForStudio(studioId)
                    && docId == 'lease'
                    && request.resource.data.keys()
                         .hasOnly(['lastScheduleSyncAt', 'scheduleSyncFailures', 'lastDeepScheduleSyncAt'])
                    && (!('lastScheduleSyncAt' in request.resource.data) || request.resource.data.lastScheduleSyncAt is number)
                    && (!('scheduleSyncFailures' in request.resource.data) || request.resource.data.scheduleSyncFailures is number)
                    && (!('lastDeepScheduleSyncAt' in request.resource.data) || request.resource.data.lastDeepScheduleSyncAt is number);
        allow delete: if isSuperAdmin();
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-schedulecoverage-month
      match /scheduleCoverage/{month} {
        allow read: if isAuthenticated() && writesForStudio(studioId);
        allow create: if isAuthenticated() && coverageWriterAllowed(studioId)
                      && coverageValid(month, request.resource.data);
        allow update: if isAuthenticated() && coverageWriterAllowed(studioId)
                      && coverageValid(month, request.resource.data)
                      && request.resource.data.days.hasAll(resource.data.days);
        allow delete: if false;
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-openingsmarks-markkey
      match /openingsMarks/{markKey} {
        function openingsMarkValid(d) {
          return d.keys().hasOnly(['weekday', 'time', 'mark', 'note', 'by', 'at'])
              && d.keys().hasAll(['weekday', 'time', 'mark', 'by', 'at'])
              && d.weekday is int && d.weekday >= 1 && d.weekday <= 6
              && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[03]0$')
              && markKey == string(d.weekday) + '-' + d.time.replace(':', '')
              && d.mark in ['full', 'room']
              && (!('note' in d) || (d.note is string && d.note.size() <= 200))
              && d.by is map && d.by.keys().hasOnly(['id', 'name'])
              && d.by.id == request.auth.uid
              && d.by.name is string && d.by.name.size() <= 120
              && d.at == request.time;
        }

        allow read: if isAuthenticated() && writesForStudio(studioId);
        allow create, update: if isAuthenticated() && coverageWriterAllowed(studioId)
                              && openingsMarkValid(request.resource.data);
        allow delete: if isAuthenticated() && coverageWriterAllowed(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-config-configid
      match /config/{configId} {
        allow read: if isAuthenticated()
                    && renewalsReadable(studioId, getRole(), callerTrainer());
        allow create, update: if isAuthenticated()
                    && ((configId == 'renewals' && renewalSettingsValid(request.resource.data))
                        || (configId == 'settings' && studioSettingsValid(request.resource.data))
                        || (configId == 'startingRoutines' && startingChoiceValid(request.resource.data)))
                    && renewalsManageable(studioId, getRole(), callerTrainer());
        allow delete: if false;
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-renewals-cyclekey
      match /renewals/{cycleKey} {
        allow read: if isAuthenticated()
                    && renewalsReadable(studioId, getRole(), callerTrainer());
        allow create, update: if isAuthenticated() && (
          (renewalsManageable(studioId, getRole(), callerTrainer()) && renewalLeaderWrite()) ||
          (renewalsReadable(studioId, getRole(), callerTrainer()) && renewalTrainerWrite()) ||
          // The renewal plan (Oct 7 2026): anyone who works here.
          (renewalsReadable(studioId, getRole(), callerTrainer()) && renewalPlanWrite())
        );
        allow delete: if false;

        match /touches/{touchId} {
          allow read: if isAuthenticated()
                      && renewalsReadable(studioId, getRole(), callerTrainer());
          allow create: if isAuthenticated()
                        && renewalsReadable(studioId, getRole(), callerTrainer())
                        && renewalTouchValid(request.resource.data);
          allow update: if false;
          allow delete: if isAuthenticated()
                        && renewalsManageable(studioId, getRole(), callerTrainer());
        }
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-roster-machineid
      match /roster/{machineId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);
        // WAVE 2 CODEX and WAVE 2 CATALOG: rosterCodexValid (the unit's model,
        // a removed safety line's reason) and rosterOutOfServiceOk() (the
        // reason on Out of service) are field checks on the document being
        // written, so they run FIRST and a bad write is refused before
        // isSuperAdmin() or the leader check read anything (the
        // 1,000-expression budget; docs/KNOWN-TRAPS.md).
        allow create, update:
          if rosterCodexValid(request.resource.data)
             && rosterOutOfServiceOk()
             && (isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId))
             && rosterWriteValid(studioId);
        // OCT 2 2026 (AJ): a studio's OWN machine is never deleted. Taking
        // it off the floor retires it (status 'inactive'): past sessions
        // keep its name and it can be brought back. A field check on the
        // stored entry, asked first so a refusal reads nothing.
        allow delete:
          if resource.data.get('source', '') != 'custom'
             && (isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId));
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-machinenotes-machineid
      match /machineNotes/{machineId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);
        allow create, update: if isAuthenticated() && isAnyAuthenticatedTrainer()
                              && writesForStudio(studioId);
        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-floornotes-noteid
      match /floorNotes/{noteId} {
        function floorNoteValid(d) {
          // A new note is never already offered: offering is an update.
          return d.keys().hasOnly(['machineId', 'machineName', 'copiedFrom', 'body', 'threadId', 'authorId', 'authorName',
                                   'createdAt', 'updatedAt', 'resolvedAt', 'resolvedBy', 'isArchived'])
              && d.machineId is string && d.machineId.size() > 0 && d.machineId.size() <= 200
              && (!('machineName' in d) || (d.machineName is string && d.machineName.size() <= 120))
              && (!('copiedFrom' in d) || d.copiedFrom in ['studio-notes', 'catalog-note', 'unit-note'])
              && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
              && (d.threadId == null || (d.threadId is string && d.threadId.size() <= 200))
              && d.authorId is string
              && d.authorName is string && d.authorName.size() <= 120
              && (d.resolvedAt == null || d.resolvedAt is timestamp)
              && (d.resolvedBy == null || (d.resolvedBy is map && d.resolvedBy.keys().hasOnly(['id', 'name'])))
              && d.isArchived is bool;
        }
        allow read: if isAuthenticated() && writesForStudio(studioId);
        // Cheapest first, and the studio check last: the role lookups behind
        // writesForStudio and the share decision are what spend Firestore's
        // 1000-expression budget (the wiki rule's lesson).
        allow create: if isAuthenticated()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && floorNoteValid(request.resource.data)
                      && writesForStudio(studioId);
        // An update touches only what may change — the words, closing and
        // reopening, archiving, the offer — and is checked on those alone; the
        // machine, the thread, the author and the day it was written stay.
        allow update: if isAuthenticated()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['body', 'updatedAt', 'resolvedAt', 'resolvedBy', 'isArchived',
                                     'shared', 'sharedKeys', 'studioName', 'shareStatus', 'shareReviewNote',
                                     'shareReviewedBy', 'shareReviewedAt', 'shareRequestedAt', 'shareRequestedBy'])
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
                      && (request.resource.data.resolvedAt == null || request.resource.data.resolvedAt is timestamp)
                      && request.resource.data.isArchived is bool
                      && sharedFieldsValid(request.resource.data)
                      // "Closed by" names the person closing, or stays as it was.
                      && (request.resource.data.resolvedBy == resource.data.resolvedBy
                          || request.resource.data.resolvedBy == null
                          || (request.resource.data.resolvedBy is map
                              && request.resource.data.resolvedBy.keys().hasOnly(['id', 'name'])
                              && request.resource.data.resolvedBy.id == request.auth.uid))
                      // The words, and taking it off the list: its author or a leader.
                      && ((request.resource.data.body == resource.data.body
                           && request.resource.data.isArchived == resource.data.isArchived)
                          || resource.data.authorId == request.auth.uid
                          || isStudioOwnerOrHeadTrainer(studioId))
                      && shareDecisionOk()
                      && writesForStudio(studioId);
        allow delete: if false;
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-vault-entryid
      match /vault/{entryId} {
        allow read, create, update, delete:
          if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-standingweeks-traineruid
      match /standingWeeks/{trainerUid} {
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && standingWeekValid(request.resource.data, studioId, trainerUid)
                      && standingWeekStampsValid(request.resource.data, request.resource.data.keys())
                      && (
                           (
                             request.auth.uid == trainerUid
                             && request.resource.data.keys().hasOnly(['studioId', 'trainerUid', 'trainerId',
                                  'trainerName', 'proposed', 'proposedAt', 'proposedBy', 'away'])
                             && trainerWorksAt(callerTrainer(), studioId)
                           )
                        || teamJobLeaderAllowed(studioId)
                      );

        allow update: if isAuthenticated()
                      && standingWeekValid(request.resource.data, studioId, trainerUid)
                      && standingWeekStampsValid(request.resource.data,
                           request.resource.data.diff(resource.data).affectedKeys())
                      && (
                           (
                             request.auth.uid == trainerUid
                             // Not trainerId: once the week exists it stays
                             // tied to the trainer the bookings are matched
                             // on (voice review follow-up). Leaders may still
                             // set it from the roster as they agree.
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['trainerName', 'proposed', 'proposedAt', 'proposedBy', 'away'])
                             && trainerWorksAt(callerTrainer(), studioId)
                           )
                        || teamJobLeaderAllowed(studioId)
                      );

        allow delete: if isAuthenticated() && teamJobLeaderAllowed(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-machinefit-machineid
      match /machineFit/{machineId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && machineFitValid(request.resource.data, studioId, machineId)
                      && request.resource.data.get('rows', {}).size() <= 1
                      && writesForStudio(studioId);

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && machineFitValid(request.resource.data, studioId, machineId)
                      && request.resource.data.get('rows', {}).diff(resource.data.get('rows', {})).affectedKeys().size() <= 1
                      && writesForStudio(studioId);

        allow delete: if isSuperAdmin();
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-watch-watchid
      match /watch/{watchId} {
        // watch/journey is the studio's leaders' alone (its own block below),
        // and so is the night's month tally (speed round, Oct 5 2026): Hours'
        // counts (watch/hours-YYYY-MM) and the month's sessions as short
        // lines for Insights (watch/sessions-YYYY-MM), written by the nightly
        // renewals job (server/month-tally-step.ts, Admin SDK) and read by the
        // people who open Hours and Insights: the studio's leaders, franchise
        // owners and administrators (wave2Leads, as watch/journey).
        allow read: if isAuthenticated() && watchId != 'journey' && (
          (watchId.matches('^(hours|sessions)-[0-9]{4}-[0-9]{2}$') && wave2Leads(studioId)) ||
          (!watchId.matches('^(hours|sessions)-[0-9]{4}-[0-9]{2}$') && writesForStudio(studioId))
        );
        allow write: if false;
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-watch-journey
      match /watch/journey {
        allow read: if isAuthenticated() && wave2Leads(studioId);
        allow write: if false;
      }

      /*
       * WAVE 2 OPERATIONS: each client's state, written nightly (Sep 28 2026).
       * One document per active client: her state, since when, what it was,
       * why, her usual gap, last visit and next booking. Written only by the
       * nightly renewals job (Admin SDK); read by the studio's leaders only —
       * the states are never shown to a trainer.
       */
      match /clientStates/{clientId} {
        allow read: if isAuthenticated() && wave2Leads(studioId);
        allow write: if false;
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-watchlist-clientid
      match /watchlist/{clientId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);
        allow create, update, delete: if isSuperAdmin()
                                      || isStudioOwnerOrHeadTrainer(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-acknowledgements-ackid
      match /acknowledgements/{ackId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);
        allow create, update: if isAuthenticated() && isAnyAuthenticatedTrainer()
                              && writesForStudio(studioId)
                              && request.resource.data.acknowledgedBy == request.auth.uid;
        allow delete: if false;
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-bookingmarks-bookingid
      match /bookingMarks/{bookingId} {
        function bookingMarkValid(d) {
          return d.keys().hasOnly(['noShow', 'clientId', 'day', 'markedBy', 'markedAt'])
              && d.keys().hasAll(['noShow', 'clientId', 'day', 'markedBy', 'markedAt'])
              && d.noShow == true
              && d.clientId is string && d.clientId.size() > 0 && d.clientId.size() <= 128
              && d.day is string && d.day.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
              && d.markedBy is map
              && d.markedBy.keys().hasOnly(['id', 'name'])
              && d.markedBy.id == request.auth.uid
              && d.markedBy.name is string && d.markedBy.name.size() <= 120
              && d.markedAt == request.time;
        }
        // Why: docs/ops/RULES-NOTES.md#studios-studioid-bookingmarks-bookingid-allow-read
        allow read: if isAuthenticated() && wave2WorksHere(studioId);
        allow create: if isAuthenticated()
                      && bookingMarkValid(request.resource.data)
                      && wave2WorksHere(studioId);
        allow update: if isAuthenticated()
                      && bookingMarkValid(request.resource.data)
                      && wave2Leads(studioId);
        allow delete: if isAuthenticated()
                      && (resource.data.markedBy.id == request.auth.uid
                          || wave2Leads(studioId));
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-cases-clientid
      match /cases/{clientId} {
        function caseValid(d) {
          return d.keys().hasOnly(['clientId', 'clientName', 'owner', 'nextStep', 'dueOn', 'outcome',
                                   'reason', 'openedAt', 'updatedAt', 'updatedBy'])
              && d.keys().hasAll(['clientId', 'clientName', 'owner', 'nextStep', 'dueOn', 'outcome',
                                  'openedAt', 'updatedAt', 'updatedBy'])
              && d.clientId == clientId
              && d.clientName is string && d.clientName.size() <= 120
              && d.owner is map
              && d.owner.keys().hasOnly(['id', 'name'])
              && d.owner.id is string && d.owner.id.size() > 0 && d.owner.id.size() <= 128
              && d.owner.name is string && d.owner.name.size() <= 120
              && d.nextStep is string && d.nextStep.size() <= 500
              && (d.dueOn == null
                  || (d.dueOn is string && d.dueOn.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
              && d.outcome in ['open', 'booked-again', 'paused', 'lost']
              && (!('reason' in d) || (d.reason is string && d.reason.size() <= 300))
              && d.updatedAt == request.time
              && d.updatedBy == request.auth.uid;
        }
        allow read: if isAuthenticated()
                    && ((resource.data.owner.id == request.auth.uid && wave2WorksHere(studioId))
                        || wave2Leads(studioId));
        allow create: if isAuthenticated()
                      && caseValid(request.resource.data)
                      && request.resource.data.openedAt == request.time
                      && wave2Leads(studioId);
        allow update: if isAuthenticated()
                      && caseValid(request.resource.data)
                      && ((resource.data.owner.id == request.auth.uid
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['nextStep', 'dueOn', 'outcome', 'reason', 'updatedAt', 'updatedBy'])
                           && wave2WorksHere(studioId))
                          || ((request.resource.data.openedAt == resource.data.openedAt
                               || request.resource.data.openedAt == request.time)
                              && wave2Leads(studioId)));
        allow delete: if false;
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-inactivemarks-clientid
      match /inactiveMarks/{clientId} {
        function inactiveMarkValid(d) {
          return d.keys().hasOnly(['clientId', 'reason', 'note', 'day', 'markedBy', 'markedAt'])
              && d.keys().hasAll(['clientId', 'reason', 'day', 'markedBy', 'markedAt'])
              && d.clientId == clientId
              && d.reason in ['moved', 'health', 'cost', 'schedule', 'break', 'other']
              && (!('note' in d) || (d.note is string && d.note.size() > 0 && d.note.size() <= 300))
              && d.day is string && d.day.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
              && d.markedBy is map
              && d.markedBy.keys().hasOnly(['id', 'name'])
              && d.markedBy.id == request.auth.uid
              && d.markedBy.name is string && d.markedBy.name.size() <= 120
              && d.markedAt == request.time;
        }
        allow read: if isAuthenticated() && wave2WorksHere(studioId);
        allow create, update: if isAuthenticated()
                              && inactiveMarkValid(request.resource.data)
                              && wave2Leads(studioId);
        allow delete: if isAuthenticated() && wave2Leads(studioId);
      }

      /*
       * MACHINE CARE (Relay, Sep 2026) -- one document per machine: when it
       * was last wiped and deep cleaned, by whom, and a flag. Written from
       * the Floor Map's care sheet by anyone who works at the studio; a wipe
       * is also appended to upkeepLog below, which Operations reads. A flag
       * is a note to the floor, never a roster status change.
       */
      match /machineCare/{machineId} {
        allow read: if isAuthenticated();

        allow create, update: if isAuthenticated()
                              && isAnyAuthenticatedTrainer()
                              && writesForStudio(studioId)
                              && machineCareValid(request.resource.data, machineId);

        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      match /upkeepLog/{entryId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isAnyAuthenticatedTrainer()
                      && writesForStudio(studioId);
        allow update: if false;
        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-tasktemplates-templateid
      match /taskTemplates/{templateId} {
        allow read: if isAuthenticated();
        // Oct 2 2026 (the Atlas answers): franchise owners add studio tasks
        // on any of their studios' shifts, as they post team jobs. The team
        // jobs' resolve-once answer (teamJobLeaderAllowed: administrators,
        // franchise owners, trainerLeads), which relay/leads.ts mirrors.
        allow create, update, delete:
          if teamJobLeaderAllowed(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-taskinstances-instanceid
      match /taskInstances/{instanceId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && (
                           !('assignedTo' in request.resource.data)
                        || request.resource.data.assignedTo == null
                        // Oct 2 2026: franchise owners name people too.
                        || teamJobLeaderAllowed(studioId)
                      );

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && (
                           !request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasAny(['assignedTo', 'assignedBy', 'assignedAt'])
                        // Oct 2 2026: franchise owners name people too.
                        || teamJobLeaderAllowed(studioId)
                      );

        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-playbook-entryid
      match /playbook/{entryId} {
        // The studio's own people (review fix, Learning + Planner round).
        // Other studios read only what is shared, through the
        // {path=**}/playbook rule below; this read used to hand every
        // signed-in user every studio's unshared tips.
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 120
                      && request.resource.data.worked is string
                      && !('clientId' in request.resource.data)
                      && sharedFieldsValid(request.resource.data)
                      && shareDecisionOk()
                      && writesForStudio(studioId);

        // An administrator deciding an offer (Sep 28 2026) edits a tip they
        // didn't write, hence isSuperAdmin() beside the author and the leader.
        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && !('clientId' in request.resource.data)
                      && sharedFieldsValid(request.resource.data)
                      && shareDecisionOk()
                      && (
                           resource.data.authorId == request.auth.uid
                        || request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['confirmations', 'lastConfirmedOn'])
                        || isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                      )
                      && writesForStudio(studioId);

        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-wiki-docid
      match /wiki/{docId} {
        // As the playbook: the studio's own people; other studios read only
        // what is shared, through {path=**}/wiki below (review fix).
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 160
                      && request.resource.data.kind in ['page', 'overlay']
                      && !('clientId' in request.resource.data)
                      && sharedFieldsValid(request.resource.data)
                      && shareDecisionOk()
                      && (
                           request.resource.data.kind == 'overlay'
                        || isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                      )
                      && writesForStudio(studioId);

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 160
                      && request.resource.data.kind == resource.data.kind
                      && !('clientId' in request.resource.data)
                      && sharedFieldsValid(request.resource.data)
                      && shareDecisionOk()
                      && (
                           resource.data.kind == 'overlay'
                        || isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                      )
                      && writesForStudio(studioId);

        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      match /taskRequests/{requestId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.createdBy.id == request.auth.uid
                      && request.resource.data.status == 'open'
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 200;

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.createdBy.id
                         == resource.data.createdBy.id;

        allow delete: if isSuperAdmin()
                      || isStudioOwnerOrHeadTrainer(studioId)
                      || resource.data.createdBy.id == request.auth.uid;

        // Replies are append-mostly: anyone may add one, only the author may
        // edit or remove their own, and management can clear anything.
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated()
                        && isAnyAuthenticatedTrainer()
                        && request.resource.data.author.id == request.auth.uid
                        && request.resource.data.body is string
                        && request.resource.data.body.size() <= 2000;
          allow update, delete: if isSuperAdmin()
                                || isStudioOwnerOrHeadTrainer(studioId)
                                || resource.data.author.id == request.auth.uid;
        }

        // Why: docs/ops/RULES-NOTES.md#studios-studioid-taskrequests-requestid-submissions-trainerid
        match /submissions/{trainerId} {
          allow read: if isAuthenticated() && isAnyAuthenticatedTrainer();
          allow create, update: if isAuthenticated()
                                && request.auth.uid == trainerId
                                && request.resource.data.trainerId == trainerId;
          allow delete: if isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                        || request.auth.uid == trainerId;
        }
      }

      // A studio's own names for its work. Authoring these sets vocabulary
      // for the whole location, and a renamed category can change which
      // upkeep row a completed task feeds (see upkeepRoleOf in
      // features/studio-tasks/types.ts), so it is a management write.
      match /taskCategories/{categoryId} {
        allow read: if isAuthenticated();
        allow create, update, delete:
          if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-teamjobs-jobid
      match /teamJobs/{jobId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && request.resource.data.createdBy.id == request.auth.uid
                      && request.resource.data.status == 'open'
                      && teamJobValid(request.resource.data, studioId)
                      && teamJobLeaderAllowed(studioId);

        allow update: if isAuthenticated()
                      && teamJobValid(request.resource.data, studioId)
                      && request.resource.data.createdBy == resource.data.createdBy
                      && (
                           (
                             request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['parts', 'assignees', 'assigneeIds', 'status', 'closedOn',
                                         'closingNote', 'completedBy', 'completedAt', 'updatedAt', 'kudos',
                                         'claims'])
                             && request.resource.data.status != 'cancelled'
                             && resource.data.status != 'cancelled'
                             && writesForStudio(studioId)
                           )
                        || teamJobLeaderAllowed(studioId)
                      );

        allow delete: if resource.data.createdBy.id == request.auth.uid
                      || teamJobLeaderAllowed(studioId);
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-noteshares-noteid
      match /noteShares/{noteId} {
        allow read: if isAuthenticated() && (
                      request.auth.uid in resource.data.audienceIds
                   || resource.data.authorId == request.auth.uid
                   || (resource.data.audience == 'team' && writesForStudio(studioId)));

        allow create: if isAuthenticated()
                      && noteShareValid(request.resource.data, studioId, noteId)
                      && writesForStudio(studioId);

        allow update: if isAuthenticated()
                      && resource.data.authorId == request.auth.uid
                      && noteShareValid(request.resource.data, studioId, noteId)
                      && writesForStudio(studioId);

        allow delete: if isAuthenticated() && (
                        resource == null
                     || resource.data.authorId == request.auth.uid
                     || isSuperAdmin()
                     || isStudioOwnerOrHeadTrainer(studioId));
      }

      // Why: docs/ops/RULES-NOTES.md#studios-studioid-comments-commentid
      match /comments/{commentId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated() && isAnyAuthenticatedTrainer()
                      && writesForStudio(studioId)
                      && commentValid(request.resource.data, studioId)
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && !('editedAt' in request.resource.data);

        allow update: if isAuthenticated()
                      && resource.data.authorId == request.auth.uid
                      && writesForStudio(studioId)
                      && commentValid(request.resource.data, studioId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['body', 'mentions', 'editedAt'])
                      && request.resource.data.editedAt == request.time;

        allow delete: if isAuthenticated() && (
                        resource.data.authorId == request.auth.uid ||
                        isSuperAdmin() ||
                        isStudioOwnerOrHeadTrainer(studioId));
      }
    }

    // Why: docs/ops/RULES-NOTES.md#path-roster-machineid
    match /{path=**}/roster/{machineId} {
      allow read: if isAuthenticated()
                  && (resource.data.shared == true || isSuperAdmin());
    }

    match /{path=**}/playbook/{entryId} {
      allow read: if isAuthenticated() && (resource.data.shared == true || isSuperAdmin());
    }

    match /{path=**}/wiki/{docId} {
      allow read: if isAuthenticated() && (resource.data.shared == true || isSuperAdmin());
    }

    // The floor's notes on a machine (Oct 3 2026): other studios read only a
    // shared one; an administrator reads the offers waiting for review.
    match /{path=**}/floorNotes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.shared == true || isSuperAdmin());
    }

    // Why: docs/ops/RULES-NOTES.md#networks-networkid
    match /networks/{networkId} {
      function networkFocusByOwner() {
        let t = callerTrainer();
        let r = authorityRole(t);
        return roleIsFranchise(r)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['relayFocus'])
            && relayFocusValid(request.resource.data.relayFocus, t)
            && resource.data.get('studioIds', []).hasAny(ownStudiosOf(r, t));
      }

      /* THE FOCUS'S SHAPE (second review): the three lines within
         FOCUS_LIMITS (admin/network/network-actions.ts: 120, 120, 500),
         signed by the writer as themselves, stamped with the server's time.
         What focusWrite sends (dot paths: relayFocus.{line}, setBy {id: the
         Auth uid, name: trainer.fullName ?? ""}, setAt serverTimestamp()),
         checked on the merged map, so a line nobody touched keeps its value
         but the signature is always the last writer's. */
      function relayFocusValid(f, t) {
        return f is map
            && f.keys().hasOnly(['mastery', 'machine', 'note', 'setBy', 'setAt'])
            && (!('mastery' in f) || (f.mastery is string && f.mastery.size() <= 120))
            && (!('machine' in f) || (f.machine is string && f.machine.size() <= 120))
            && (!('note' in f) || (f.note is string && f.note.size() <= 500))
            && f.setBy is map && f.setBy.keys().hasOnly(['id', 'name'])
            && f.setBy.id == request.auth.uid
            && f.setBy.name == t.get('fullName', '')
            && f.setAt == request.time;
      }

      allow read: if isAuthenticated();
      allow create: if superOnRecord();
      allow update: if superOnRecord() || (isAuthenticated() && networkFocusByOwner());
      allow delete: if superOnRecord();
    }

    match /aggregations/{aggId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /clinicalIncidents/{incidentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // Why: docs/ops/RULES-NOTES.md#access-requests-requestid
    match /access_requests/{requestId} {
      function requestStudioLed(r, t, s) {
        return s is string && s != '' && !isDemoStudioId(s) && trainerLeads(r, t, s);
      }
      function requestNamesStudioILead(d) {
        let r = getRole();
        let t = callerTrainer();
        return requestStudioLed(r, t, d.get('requestedStudioId', ''))
            || requestStudioLed(r, t, d.get('studioId', ''));
      }

      /* A STUDIO-ACCESS REQUEST (Type 2) names one real studio, in
         studioId only, and sits at sa_{uid}_{studioId} (second review: it
         took any document id, so anyone could create one at a stranger's
         uid first and block that stranger's own sign-up at
         access_requests/{uid}; and it could carry userId and
         requestedStudioId, the fields the approval path trusts). A
         Firebase Auth uid has no underscore, so this id is never a uid. */
      function studioAccessShape(d) {
        return d.type == 'studio_access'
            && d.trainerId == request.auth.uid
            && !d.keys().hasAny(['userId', 'requestedStudioId'])
            && d.get('studioId', '') is string && d.get('studioId', '') != ''
            && !isDemoStudioId(d.get('studioId', ''))
            && requestId == 'sa_' + request.auth.uid + '_' + d.get('studioId', '');
      }

      allow read: if isAuthenticated() && (
                    requestId == request.auth.uid ||
                    resource.data.get('trainerId', '') == request.auth.uid ||
                    resource.data.get('userId', '') == request.auth.uid ||
                    isSuperAdmin() ||
                    requestNamesStudioILead(resource.data)
                  );
      allow create: if (
                      // Type 1: Initial System Access
                      (
                        isAuthenticated() &&
                        requestId == request.auth.uid &&
                        request.resource.data.get('userId', '') == request.auth.uid &&
                        hasRequiredFields(['email', 'fullName']) &&
                        request.resource.data.email is string && request.resource.data.email.size() < 100 &&
                        request.resource.data.fullName is string && request.resource.data.fullName.size() < 100 &&
                        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() < 50)) &&
                        (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() < 1000)) &&
                        request.resource.data.status == 'Pending'
                      ) ||
                      // Type 2: Studio Access, at its own id (studioAccessShape)
                      (isAuthenticated()
                       && studioAccessShape(request.resource.data)
                       && request.resource.data.status == 'Pending')
                    );
      // Why: docs/ops/RULES-NOTES.md#access-requests-requestid-allow-update
      allow update: if isSuperAdmin() ||
                    (isAuthenticated() && requestNamesStudioILead(resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'approvedTrainerId', 'updatedAt'])
                      && request.resource.data.status in ['Approved', 'Denied']) ||
                    (isAuthenticated() && resource.data.get('trainerId', '') == request.auth.uid
                      && studioAccessShape(request.resource.data)
                      && request.resource.data.studioId == resource.data.get('studioId', ''));
      allow delete: if isSuperAdmin() ||
                    (isAuthenticated() && requestNamesStudioILead(resource.data));
    }

    // Why: docs/ops/RULES-NOTES.md#bug-reports-reportid
    match /bug_reports/{reportId} {
      // Why: docs/ops/RULES-NOTES.md#bugreplyvalid
      function bugReplyValid(d) {
        return !('reply' in d)
            || d.reply == resource.data.get('reply', null)
            || (d.reply is map
                && d.reply.keys().hasOnly(['text', 'by', 'at'])
                && d.reply.text is string && d.reply.text.size() > 0 && d.reply.text.size() <= 1000
                && d.reply.by is map && d.reply.by.keys().hasOnly(['uid', 'name'])
                && d.reply.by.uid == request.auth.uid
                && d.reply.by.name is string && d.reply.by.name.size() <= 120
                && d.reply.at == request.time);
      }

      allow read: if isSuperAdmin()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && !('reply' in request.resource.data);
      allow update: if isAuthenticated() && bugReplyValid(request.resource.data) && isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Why: docs/ops/RULES-NOTES.md#activity-entryid
    match /activity/{entryId} {
      function activityValid(d) {
        return d.keys().hasOnly(['at', 'by', 'studioId', 'kind', 'what', 'before', 'after'])
            && d.keys().hasAll(['at', 'by', 'studioId', 'kind', 'what'])
            && d.at == request.time
            && d.by is map && d.by.keys().hasOnly(['uid', 'name'])
            && d.by.uid == request.auth.uid
            && d.by.name is string && d.by.name.size() > 0 && d.by.name.size() <= 120
            && (d.studioId == null || (d.studioId is string && d.studioId.size() > 0 && d.studioId.size() <= 120))
            && d.kind in ['standard-edit', 'standard-set', 'publish', 'admin-grant',
                          'assisted-change', 'setting-default', 'studio-stage']
            && d.what is string && d.what.size() > 0 && d.what.size() <= 500
            && (!('before' in d) || (d.before is map && d.before.size() <= 20))
            && (!('after' in d) || (d.after is map && d.after.size() <= 20));
      }

      // The caller resolved once (the expression budget, KNOWN-TRAPS).
      function activityReadAllowed(d) {
        let r = getRole();
        return roleIsSuper(r)
            || (d.get('studioId', null) is string
                && trainerLeads(r, callerTrainer(), d.get('studioId', null)));
      }

      allow read: if isAuthenticated() && activityReadAllowed(resource.data);
      allow create: if isAuthenticated() && activityValid(request.resource.data) && isSuperAdmin();
      allow update, delete: if false;
    }

    // Why: docs/ops/RULES-NOTES.md#studios-studioid-setupitems-itemid
    match /studios/{studioId}/setupItems/{itemId} {
      function setupItemValid(d) {
        return d.keys().hasOnly(['block', 'title', 'dueOn', 'doneAt', 'doneBy', 'skipReason'])
            && d.keys().hasAll(['block', 'title'])
            && d.block in ['studio', 'mindbody', 'floor', 'people', 'first-week']
            && d.title is string && d.title.size() > 0 && d.title.size() <= 160
            && (!('dueOn' in d) || d.dueOn == null
                || (d.dueOn is string && d.dueOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && (!('doneAt' in d) || d.doneAt == null || d.doneAt is timestamp)
            && (!('doneBy' in d) || d.doneBy == null
                || (d.doneBy is map && d.doneBy.keys().hasOnly(['uid', 'name'])
                    && d.doneBy.name is string && d.doneBy.name.size() <= 120
                    && (d.doneBy.uid == request.auth.uid
                        || (resource != null && resource.data.get('doneBy', null) == d.doneBy))))
            && (!('skipReason' in d) || d.skipReason == null
                || (d.skipReason is string && d.skipReason.size() > 0 && d.skipReason.size() <= 200));
      }

      function setupReadAllowed(studioId) {
        let r = getRole();
        return roleIsSuper(r) || trainerLeads(r, callerTrainer(), studioId);
      }

      allow read: if isAuthenticated() && setupReadAllowed(studioId);
      allow create, update: if isAuthenticated() && setupItemValid(request.resource.data) && isSuperAdmin();
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // Why: docs/ops/RULES-NOTES.md#adminhome-itemkey
    match /adminHome/{itemKey} {
      function homeMarkValid(d) {
        return d.keys().hasOnly(['state', 'by', 'until', 'reason', 'at'])
            && d.keys().hasAll(['state', 'by', 'at'])
            && d.state in ['taken', 'snoozed', 'dismissed']
            && d.by is map && d.by.keys().hasOnly(['uid', 'name'])
            && d.by.uid == request.auth.uid
            && d.by.name is string && d.by.name.size() <= 120
            && d.at == request.time
            && (!('until' in d) || (d.until is string && d.until.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && (!('reason' in d) || (d.reason is string && d.reason.size() > 0 && d.reason.size() <= 200))
            && (d.state != 'snoozed' || 'until' in d)
            && (d.state != 'dismissed' || 'reason' in d)
            && itemKey.size() <= 200;
      }

      allow read: if isAuthenticated() && isSuperAdmin();
      allow create, update: if isAuthenticated() && homeMarkValid(request.resource.data) && isSuperAdmin();
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // Why: docs/ops/RULES-NOTES.md#announcementreads-uid
    match /announcementReads/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create, update: if isAuthenticated() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['ids', 'updatedAt', 'acks'])
                    && (!('ids' in request.resource.data) || request.resource.data.ids is map)
                    && (!('acks' in request.resource.data) || request.resource.data.acks is map);
      allow delete: if false;
    }

    match /hub_announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hubAnnouncementCreateAllowed();
      allow update: if isAuthenticated() && hubAnnouncementUpdateAllowed();
      // Nothing in the app deletes a notice (AnnouncementComposer and
      // StudioSection take one down with isActive: false). Only an
      // administrator deletes, so a notice's id is never freed for someone
      // else to re-create as its author and read its acks, which outlive
      // it (acks: delete false). The franchise partition, second review.
      allow delete: if superOnRecord();
    }

    // Why: docs/ops/RULES-NOTES.md#announcementacksreadable
    function announcementAcksReadable(announcementId) {
      let r = getRole();
      let a = get(/databases/$(database)/documents/hub_announcements/$(announcementId)).data;
      return roleIsSuper(r)
          || a.get('authorId', '') == request.auth.uid
          || trainerLeads(r, callerTrainer(), a.get('targetId', a.get('studioId', '')));
    }

    match /hub_announcements/{announcementId}/acks/{uid} {
      allow read: if isAuthenticated() && announcementAcksReadable(announcementId);
      allow create, update: if isAuthenticated() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['at', 'name'])
                    && request.resource.data.at == request.time
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && exists(/databases/$(database)/documents/hub_announcements/$(announcementId));
      allow delete: if false;
    }

    // CATALOG SUBMISSIONS (My Studio round, Sep 2026). A studio's leaders
    // offer one of the studio's OWN machines to corporate for the MSF
    // catalog (My Studio -> Machines -> Offer to the MSF catalog). Corporate
    // decides -- administrators only -- and publishing is an id migration
    // run from the PC (scripts/migrate-machine-id.ts), never a tap here.
    // The submitting studio reads its own; the roster entry carries a copy
    // of the status so the floor can show it.
    match /catalogSubmissions/{submissionId} {
      allow read: if isSuperAdmin()
                  || (isAuthenticated() && resource.data.get('studioId', '') != ''
                      && trainerLeads(getRole(), callerTrainer(), resource.data.studioId));
      allow create: if isAuthenticated()
                    && catalogSubmissionValid(request.resource.data)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.submittedBy == request.auth.uid
                    && trainerLeads(getRole(), callerTrainer(), request.resource.data.studioId);
      // Corporate decides; the studio may only withdraw a pending offer.
      allow update: if isSuperAdmin()
                    || (isAuthenticated()
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'withdrawn'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                        && trainerLeads(getRole(), callerTrainer(), resource.data.studioId));
      allow delete: if isSuperAdmin();
    }

    // NOTIFICATION QUEUE (for email/SMS triggers)
    match /notificationQueue/{notifId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // MINDBODY INTEGRATION
    // ===============================================================

    // Permanent cross-train access record. Grants nothing: no rule or
    // reader may ever treat this as access (the franchise partition, second
    // review; reconcile.ts calls it "unwritten by the app"). The one thing
    // that grants a cross-train read is clients/{id}.approvedCrossTrainStudioIds.
    match /clients/{clientId}/crossTrainAccess/{studioId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || (
        isStudioOwnerOrHeadTrainer(studioId) &&
        request.resource.data.grantedBy == request.auth.uid &&
        request.resource.data.keys().hasAll(['granted', 'grantedAt', 'grantedBy']) &&
        request.resource.data.granted == true
      );
      allow delete: if isAdmin() || isFounder();
    }

    // Cross-train request submissions. Grants nothing: no rule or reader
    // may ever treat this as access (the franchise partition, second review).
    match /crossTrainRequests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.requestingTrainerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isAuthenticated();
      allow update: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(resource.data.targetStudioId);
      allow delete: if isSuperAdmin();
    }

    // Webhook idempotency log (server-only writes; admins can read)
    match /mindbodyEventLog/{messageId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Dead letter queue (server writes; admins read and resolve)
    match /mindbodyDLQ/{messageId} {
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow create, delete: if false;
    }

    // Limbo queue: bookings/clients the webhook or pull-sync could not file
    // against a studio. The webhook's writes come from the Admin SDK (bypasses
    // rules entirely); the pull-sync's parkPullSyncBooking() runs client-side
    // and needs create access, and the Admin UI's release/resolve path needs
    // update access. No rule existed here before, so the global safety net
    // denied read AND write to every user regardless of role.
    match /mindbodyLimbo/{eventId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // Max Strength's defaults for the studio settings (Sep 28 2026, AJ: "let
    // the admins assign the default within the app"): every signed-in person
    // reads them, since every studio falls back to them; administrators write
    // them from Admins -> Standard -> Studio defaults.
    match /system/studioDefaults {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() && studioSettingsValid(request.resource.data);
      allow delete: if false;
    }

    // Global integration health (server writes; all authenticated users read for UI)
    match /system/health {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Whether Mindbody's webhook subscription is on (the cost plan, Sep 26
    // 2026, A7): written nightly by the renewals cron through the Admin SDK,
    // read by Operations -> Mindbody. Status and event names only, never the
    // subscription's signing key.
    match /system/mindbodyWebhook {
      allow read: if isAuthenticated();
      allow write: if false;
    }

  }
}
